<edit-config>
    <target>
        <running/>
    </target>
    <test-option>test-then-set</test-option>
    <error-option>rollback-on-error</error-option>
    <config xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
        <onus xmlns="urn:bbf:yang:bbf-onus">
          <template xmlns="urn:bbf:yang:bbf-onu-management">
            <name>Prod_XGS_SFU_BRCM55040B</name>
            <data>
              <hardware xmlns="urn:bbf:yang:bbf-onu-hardware">
                <component>
                  <name>eth1</name>
                  <class xmlns:bbf-hwt="urn:bbf:yang:bbf-hardware-types">bbf-hwt:rj45</class>
                  <parent>xpon-nt</parent>
                  <parent-rel-pos>1</parent-rel-pos>
                </component>
                <component>
                  <name>transceiver</name>
                  <class xmlns:bbf-hwt="urn:bbf:yang:bbf-hardware-types">bbf-hwt:transceiver</class>
                  <parent>xpon-nt</parent>
                  <parent-rel-pos>1</parent-rel-pos>
                </component>
                <component>
                  <name>transceiver-link</name>
                  <class xmlns:bbf-hwt="urn:bbf:yang:bbf-hardware-types">bbf-hwt:transceiver-link</class>
                  <parent>transceiver</parent>
                  <parent-rel-pos>1</parent-rel-pos>
                </component>
                <component>
                  <name>xpon-nt</name>
                  <class xmlns:bbf-hwt="urn:bbf:yang:bbf-hardware-types">bbf-hwt:xpon-nt</class>
                </component>
              </hardware>
              <interfaces xmlns="urn:bbf:yang:bbf-onu-interfaces">
                <interface>
                  <name>ani</name>
                  <type xmlns:bbf-onuift="urn:bbf:yang:bbf-onu-if-type">bbf-onuift:ani</type>
                  <hardware-component xmlns="urn:bbf:yang:bbf-onu-interface-to-hardware">
                    <port-layer-if>transceiver-link</port-layer-if>
                  </hardware-component>
                </interface>
                <interface>
                  <name>eth1</name>
                  <type xmlns:bbf-onuift="urn:bbf:yang:bbf-onu-if-type">bbf-onuift:ethernetCsmacd</type>
                  <hardware-component xmlns="urn:bbf:yang:bbf-onu-interface-to-hardware">
                    <port-layer-if>eth1</port-layer-if>
                  </hardware-component>
                </interface>
                <interface>
                  <name>eth1.vsi.cvlan2000.untag</name>
                  <type xmlns:bbf-onuift="urn:bbf:yang:bbf-onu-if-type">bbf-onuift:vlan-sub-interface</type>
                  <ingress-qos-policy-profile xmlns="urn:bbf:yang:bbf-onu-interfaces-qos">pp-all-to-tc0</ingress-qos-policy-profile>
                  <vsi-profile xmlns="urn:bbf:yang:bbf-onu-interfaces-vsi-profile">
                    <vsi-profile>Prod_XGS_SFU_BRCM55040B__vsi-prfl-cvlan2000.untag</vsi-profile>
                  </vsi-profile>
                  <subif-lower-layer xmlns="urn:bbf:yang:bbf-onu-sub-interfaces">
                    <interface>eth1</interface>
                  </subif-lower-layer>
                </interface>
              </interfaces>
            </data>
          </template>
        </onus>
    </config>
</edit-config>
