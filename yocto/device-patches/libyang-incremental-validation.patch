+    const char *setup_when[] = {"-/b:b-top/b:b-chk[b:name='k1']", NULL, "-/c:c-refs/c:c-ref[c:name='r1']", NULL,
+        "/b:b-top/b-chk[name='k4']/ifname", "e1", "/b:b-top/b-chk[name='k4']/hi", "y", NULL, NULL};
