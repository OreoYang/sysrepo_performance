+        /* augment: LOCAL, read from the augmented list */
+        "    augment \"/dl:xw/dl:e\" {\n"
+        "        when \"derived-from-or-self(dl:kind, 'dl:cap-sub')\";\n"
+        "        leaf x1 { type string; }\n"
+        "    }\n"
+        "    augment \"/dl:xw/dl:e\" {\n"
+        "        when \"dl:sel = 'a'\";\n"
+        "        container x6 { leaf v { type string; } }\n"
+        "        leaf x12 { type string; }\n"
+        "    }\n"
