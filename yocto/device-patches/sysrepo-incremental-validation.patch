+/**
+ * @brief Whether the incremental validator may be used for this change.
+ *
+ * Decided at build time, cmake -DENABLE_VALIDATE_INCREMENTAL=OFF turns it off (on by default).
+ */
+static int
+sr_modinfo_validate_incr(const struct sr_mod_info_s *mod_info, int diff_is_complete, int finish_diff)
+{
+#ifdef ENABLE_VALIDATE_INCREMENTAL
+    return diff_is_complete && finish_diff && mod_info->notify_diff && SR_IS_CONVENTIONAL_DS(mod_info->ds);
+#else
+    (void)mod_info;
+    (void)diff_is_complete;
+    (void)finish_diff;
+
+    return 0;
+#endif
+}
+
+/**
+ * @brief Whether this connection already validated the stored data of a module in full since its context was created.
+ *
+ * Incremental validation trusts the stored data. Running copied from startup on boot, data written around sysrepo
+ * and data left by an interrupted process have never been validated, so the first change of every module after
+ * a context is created is validated in full.
+ */
+static int
+sr_modinfo_val_full_known(sr_conn_ctx_t *conn, const struct lys_module *ly_mod, sr_datastore_t ds)
+{
+    sr_error_info_t *err_info = NULL;
+    int known;
+
+    if ((err_info = sr_mlock(&conn->val_full_lock, -1, __func__, NULL, NULL))) {
+        sr_errinfo_free(&err_info);
+        return 0;
+    }
+    known = ly_set_contains(&conn->val_full[ds], (void *)ly_mod, NULL);
+    sr_munlock(&conn->val_full_lock);
+
+    return known;
+}
+
+void
+sr_modinfo_val_full_stored(struct sr_mod_info_s *mod_info)
+{
+    sr_error_info_t *err_info = NULL;
+    uint32_t i;
+
+    if ((err_info = sr_mlock(&mod_info->conn->val_full_lock, -1, __func__, NULL, NULL))) {
+        sr_errinfo_free(&err_info);
+        return;
+    }
+    for (i = 0; i < mod_info->mod_count; ++i) {
+        if (mod_info->mods[i].state & MOD_INFO_VAL_FULL) {
+            /* not remembering it only costs another full validation */
+            ly_set_add(&mod_info->conn->val_full[mod_info->ds], (void *)mod_info->mods[i].ly_mod, 0, NULL);
+        }
+    }
+    sr_munlock(&mod_info->conn->val_full_lock);
+}
+
+void
+sr_validate_incr_status_log(void)
+{
+    static int logged;
+
+    /* once per process, it is the only way to tell from the logs whether this build uses the incremental validator */
+    if (__sync_lock_test_and_set(&logged, 1)) {
+        return;
+    }
+#ifdef ENABLE_VALIDATE_INCREMENTAL
+    SR_LOG_WRN("Incremental YANG validation: compiled in (ENABLE_VALIDATE_INCREMENTAL=ON).");
+#else
+    SR_LOG_WRN("Incremental YANG validation: not compiled in (ENABLE_VALIDATE_INCREMENTAL=OFF).");
+#endif
+}
+
+void
+sr_validate_incr_stats_log(void)
+{
+    uint64_t calls = 0, fallbacks = 0, late = 0, shallow = 0;
+
+    /* process totals: sysrepo drops the context on every schema change, per-context counters would not survive */
+    lyd_validate_incr_stats(NULL, &calls, &fallbacks);
+    lyd_validate_incr_late_stats(NULL, &late);
+    lyd_validate_incr_shallow_stats(NULL, &shallow);
+    if (!calls) {
+        return;
+    }
+
+    /* the fallback rate decides whether the incremental validator is actually doing anything, the late ones are
+     * a rule that deletes data on most edits; it is on by default, so only a fallback is worth a warning */
+    if (fallbacks) {
+        SR_LOG_WRN("Incremental validation: %" PRIu64 " calls, %" PRIu64 " fallbacks (%.1f%%), %" PRIu64 " late, %"
+                PRIu64 " shallow deletes.", calls, fallbacks, (100.0 * (double)fallbacks) / (double)calls, late,
+                shallow);
+    } else {
+        SR_LOG_INF("Incremental validation: %" PRIu64 " calls, 0 fallbacks, %" PRIu64 " shallow deletes.", calls,
+                shallow);
+    }
+}
