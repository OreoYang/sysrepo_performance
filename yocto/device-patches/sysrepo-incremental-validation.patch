+static void
+apply_edits(sr_session_ctx_t *sess, const char *const *edits)
+{
+    uint32_t e;
+
+    for (e = 0; edits[e]; e += 2) {
+        if (edits[e][0] == '-') {
+            assert_int_equal(SR_ERR_OK, sr_delete_item(sess, edits[e] + 1, 0));
+        } else {
+            assert_int_equal(SR_ERR_OK, sr_set_item_str(sess, edits[e], edits[e + 1], NULL, 0));
+        }
+    }
+}
