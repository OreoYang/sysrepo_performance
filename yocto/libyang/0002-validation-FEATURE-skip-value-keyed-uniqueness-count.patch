diff --git a/src/validation_deps.c b/src/validation_deps.c
index 9980da0..359dfe7 100644
--- a/src/validation_deps.c
+++ b/src/validation_deps.c
@@ -444,6 +444,97 @@ lyd_val_dep_preds_are_keys(const struct lyxp_expr *expr, const struct ly_set *at
     return 1;
 }
 
+/**
+ * @brief Local name of a NameTest token.
+ */
+static const char *
+lyd_val_dep_nametest_local(const struct lyxp_expr *expr, uint32_t tok, uint32_t *len)
+{
+    const char *name = expr->expr + expr->tok_pos[tok];
+    uint32_t i;
+
+    *len = expr->tok_len[tok];
+    for (i = 0; i < *len; ++i) {
+        if (name[i] == ':') {
+            *len -= i + 1;
+            return name + i + 1;
+        }
+    }
+    return name;
+}
+
+/**
+ * @brief Whether an expression counts nothing but the instances holding the same @p snode value as the instance
+ * it is evaluated on.
+ *
+ * Accepted shape is exactly "count(<path>[<snode> = current()]) <cmp> <number>", where the path is a plain
+ * location path whose only predicate is its last step, and where every node the expression reads lies on the
+ * ancestor chain of @p snode. Together that leaves the value of the validated instance as the expression's only
+ * input besides the tree, so the result can only change when an instance of @p snode holding that value appears
+ * or disappears.
+ */
+static ly_bool
+lyd_val_dep_value_keyed_shape(const struct lyxp_expr *expr, const struct lysc_node *snode, const struct ly_set *atoms)
+{
+    uint32_t end, brack1, i, len;
+    const char *name;
+    ly_bool self = 0;
+
+    if (!expr || !atoms || !(snode->nodetype & LYD_NODE_TERM)) {
+        return 0;
+    }
+
+    /* count( ... ) <cmp> <number> and nothing else */
+    if ((expr->used < 2) || (expr->tokens[0] != LYXP_TOKEN_FUNCNAME) || !lyd_val_dep_tok_is(expr, 0, "count") ||
+            (expr->tokens[1] != LYXP_TOKEN_PAR1)) {
+        return 0;
+    }
+    end = lyd_val_dep_call_end(expr, 0);
+    if ((end < 9) || (end + 3 != expr->used) || (expr->tokens[end] != LYXP_TOKEN_PAR2) ||
+            (expr->tokens[end + 1] != LYXP_TOKEN_OPER_COMP) || (expr->tokens[end + 2] != LYXP_TOKEN_NUMBER)) {
+        return 0;
+    }
+
+    /* the single predicate is the last step of the path: [<name> = current()] */
+    brack1 = end - 7;
+    if ((expr->tokens[brack1] != LYXP_TOKEN_BRACK1) || (expr->tokens[brack1 + 1] != LYXP_TOKEN_NAMETEST) ||
+            (expr->tokens[brack1 + 2] != LYXP_TOKEN_OPER_EQUAL) ||
+            (expr->tokens[brack1 + 3] != LYXP_TOKEN_FUNCNAME) || !lyd_val_dep_tok_is(expr, brack1 + 3, "current") ||
+            (expr->tokens[brack1 + 4] != LYXP_TOKEN_PAR1) || (expr->tokens[brack1 + 5] != LYXP_TOKEN_PAR2) ||
+            (expr->tokens[brack1 + 6] != LYXP_TOKEN_BRACK2)) {
+        return 0;
+    }
+
+    /* everything before it is a plain location path, so there is no other predicate and no other function */
+    for (i = 2; i < brack1; ++i) {
+        if ((expr->tokens[i] != LYXP_TOKEN_OPER_PATH) && (expr->tokens[i] != LYXP_TOKEN_NAMETEST)) {
+            return 0;
+        }
+    }
+
+    /* the predicate compares the constrained node itself */
+    name = lyd_val_dep_nametest_local(expr, brack1 + 1, &len);
+    if ((strlen(snode->name) != len) || strncmp(snode->name, name, len)) {
+        return 0;
+    }
+
+    /* the expression reads only the constrained node and its ancestors, so its node set is selected by nothing
+     * but the compared value */
+    for (i = 0; i < atoms->count; ++i) {
+        if (!atoms->snodes[i]) {
+            continue;
+        }
+        if (!lyd_val_dep_is_ancestor(atoms->snodes[i], snode)) {
+            return 0;
+        }
+        if (atoms->snodes[i] == snode) {
+            self = 1;
+        }
+    }
+
+    return self;
+}
+
 enum lyd_val_dep_class
 lyd_val_dep_classify_expr(const struct lysc_node *ctx_node, const struct lys_module *cur_mod,
         const struct lyxp_expr *expr, const struct lysc_prefix *prefixes, struct ly_set **atoms,
@@ -616,6 +707,42 @@ lyd_val_dep_add(struct lyd_val_dep_index *index, const struct lysc_node *snode,
     return LY_SUCCESS;
 }
 
+/**
+ * @brief Mark the constraint added last as value-keyed.
+ */
+static LY_ERR
+lyd_val_dep_value_keyed_mark(struct lyd_val_dep_index *index, const struct lyxp_expr *cond)
+{
+    uint32_t *vk;
+
+    vk = realloc(index->value_keyed, (index->value_keyed_count + 1) * sizeof *index->value_keyed);
+    if (!vk) {
+        return LY_EMEM;
+    }
+    index->value_keyed = vk;
+    index->value_keyed[index->value_keyed_count++] = index->constraint_count - 1;
+
+    index->constraints[index->constraint_count - 1].cond = cond;
+    index->constraints[index->constraint_count - 1].value_keyed = 1;
+    return LY_SUCCESS;
+}
+
+ly_bool
+lyd_val_deps_value_keyed(const struct lyd_val_dep_index *index, const struct lysc_node *snode,
+        const struct lyxp_expr *cond)
+{
+    const struct lyd_val_constraint *c;
+    uint32_t i;
+
+    for (i = 0; i < index->value_keyed_count; ++i) {
+        c = &index->constraints[index->value_keyed[i]];
+        if ((c->snode == snode) && (c->cond == cond)) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
 /**
  * @brief Classify every leafref inside a (possibly union) type.
  */
@@ -703,6 +830,13 @@ lyd_val_dep_add_node(struct lyd_val_dep_index *index, const struct lysc_node *sn
         cls = lyd_val_dep_classify_expr(snode, snode->module, musts[u].cond, musts[u].prefixes,
                 &atom_set, &creation_safe, &unit);
         rc = lyd_val_dep_add(index, snode, LYD_VAL_DEP_MUST, cls, creation_safe, unit, musts[u].cond->expr, atom_set);
+
+        /* an implicit default appears without the edit describing it, so its value could not be recognised as
+         * touched and the constraint has to keep being evaluated on every instance */
+        if (!rc && (cls == LYD_VAL_DEP_BOUNDED) && !lyd_val_dep_is_implicit(snode) &&
+                lyd_val_dep_value_keyed_shape(musts[u].cond, snode, atom_set)) {
+            rc = lyd_val_dep_value_keyed_mark(index, musts[u].cond);
+        }
         ly_set_free(atom_set, NULL);
         LY_CHECK_RET(rc);
     }
@@ -744,6 +878,7 @@ lyd_val_dep_index_free(struct lyd_val_dep_index *index)
     }
     free(index->constraints);
     free(index->nonlocal);
+    free(index->value_keyed);
     ly_set_erase(&index->toplevel_atoms, NULL);
     ly_set_erase(&index->dflt_when, NULL);
     free(index);
diff --git a/src/validation_deps.h b/src/validation_deps.h
index 6bee7b3..04e43f4 100644
--- a/src/validation_deps.h
+++ b/src/validation_deps.h
@@ -59,10 +59,21 @@ enum lyd_val_dep_kind {
 struct lyd_val_constraint {
     const struct lysc_node *snode;      /**< node the constraint is attached to */
     const char *expr;                   /**< expression text, not owned */
+    const struct lyxp_expr *cond;       /**< parsed expression, only set for a value-keyed constraint */
     const struct lysc_node **atoms;     /**< NULL-terminated schema nodes the expression reads */
     enum lyd_val_dep_kind kind;
     enum lyd_val_dep_class cls;
 
+    /**
+     * @brief Whether the constraint only counts the instances of ::lyd_val_constraint.snode that share the value
+     * of the instance it is evaluated on.
+     *
+     * Such a constraint reads nothing but one value bucket, so an edit that leaves a bucket alone cannot turn it
+     * from satisfied to violated on any instance holding that value. Recognised shape:
+     * "count(<path>[<snode> = current()]) <cmp> <number>".
+     */
+    ly_bool value_keyed;
+
     /**
      * @brief Whether creating data can never turn this constraint from satisfied to violated.
      *
@@ -95,6 +106,9 @@ struct lyd_val_dep_index {
     uint32_t *nonlocal;                 /**< indices of ::LYD_VAL_DEP_BOUNDED / ::LYD_VAL_DEP_UNBOUNDED constraints */
     uint32_t nonlocal_count;
 
+    uint32_t *value_keyed;              /**< indices of constraints with ::lyd_val_constraint.value_keyed set */
+    uint32_t value_keyed_count;
+
     /**
      * @brief Schema nodes read by a constraint that no list confines.
      *
@@ -140,6 +154,17 @@ enum lyd_val_dep_class lyd_val_dep_classify_expr(const struct lysc_node *ctx_nod
  */
 LY_ERR lyd_val_deps_get(const struct lys_module *mod, const struct lyd_val_dep_index **index);
 
+/**
+ * @brief Whether a specific constraint of a node is value-keyed.
+ *
+ * @param[in] index Dependency index of the node's module.
+ * @param[in] snode Node the constraint is attached to.
+ * @param[in] cond Parsed expression of the constraint.
+ * @return Whether the constraint was classified as value-keyed, see ::lyd_val_constraint.value_keyed.
+ */
+ly_bool lyd_val_deps_value_keyed(const struct lyd_val_dep_index *index, const struct lysc_node *snode,
+        const struct lyxp_expr *cond);
+
 /**
  * @brief Free all cached dependency indexes of a context.
  *
diff --git a/src/validation_incr.c b/src/validation_incr.c
index cff70ca..339cd39 100644
--- a/src/validation_incr.c
+++ b/src/validation_incr.c
@@ -30,19 +30,49 @@
 #include "validation.h"
 #include "validation_deps.h"
 
+/**
+ * @brief Values of one value-keyed node that the edit created, deleted or replaced.
+ *
+ * A value-keyed constraint reads nothing but the instances sharing one value, so only the values listed here can
+ * have changed its result, see ::lyd_val_constraint.value_keyed.
+ */
+struct lyd_val_incr_valset {
+    const struct lysc_node *snode;  /**< value-keyed node the values belong to */
+    const char **vals;              /**< values, borrowed from the edit diff */
+    uint32_t val_count;
+    ly_bool unknown;                /**< the diff touched the node without spelling out its value */
+};
+
 /**
  * @brief Everything the edit diff tells us about what may need revalidating.
  */
 struct lyd_val_incr {
+    const struct lys_module *mod;   /**< module being validated */
+    const struct lyd_val_dep_index *index;  /**< dependency index of ::lyd_val_incr.mod, owned by the context */
     struct ly_set roots;        /**< data subtrees to validate in full */
     struct ly_set path;         /**< ::lyd_val_incr.roots and all their data ancestors */
     struct ly_set extra;        /**< individual nodes outside the scope whose cross-instance constraints
                                      the edit could have changed */
     struct ly_set created;      /**< schema nodes the edit only created */
     struct ly_set modified;     /**< schema nodes the edit deleted or whose value it replaced */
+    struct lyd_val_incr_valset *valsets;    /**< edited values of every value-keyed node the edit touched */
+    uint32_t valset_count;
     ly_bool fallback;           /**< the edit could not be analysed, validate the whole module */
 };
 
+static void
+lyd_val_incr_valsets_erase(struct lyd_val_incr *incr)
+{
+    uint32_t i;
+
+    for (i = 0; i < incr->valset_count; ++i) {
+        free((void *)incr->valsets[i].vals);
+    }
+    free(incr->valsets);
+    incr->valsets = NULL;
+    incr->valset_count = 0;
+}
+
 static void
 lyd_val_incr_erase(struct lyd_val_incr *incr)
 {
@@ -51,6 +81,7 @@ lyd_val_incr_erase(struct lyd_val_incr *incr)
     ly_set_erase(&incr->extra, NULL);
     ly_set_erase(&incr->created, NULL);
     ly_set_erase(&incr->modified, NULL);
+    lyd_val_incr_valsets_erase(incr);
 }
 
 /**
@@ -115,6 +146,177 @@ lyd_val_incr_touch(struct ly_set *set, const struct lysc_node *snode)
     return LY_SUCCESS;
 }
 
+/**
+ * @brief Whether @p anc is @p snode or one of its schema ancestors.
+ */
+static ly_bool
+lyd_val_incr_snode_covers(const struct lysc_node *anc, const struct lysc_node *snode)
+{
+    for ( ; snode; snode = lysc_data_parent(snode)) {
+        if (snode == anc) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/**
+ * @brief Value a replaced node held before the edit, if the diff says.
+ */
+static const char *
+lyd_val_incr_orig_value(const struct lyd_node *node)
+{
+    const struct lyd_meta *meta;
+
+    LY_LIST_FOR(node->meta, meta) {
+        if (!strcmp(meta->name, "orig-value") && !strcmp(meta->annotation->module->name, "yang")) {
+            return lyd_get_meta_value(meta);
+        }
+    }
+    return NULL;
+}
+
+/**
+ * @brief Get (adding it first if needed) the value set of a value-keyed node.
+ */
+static LY_ERR
+lyd_val_incr_valset_get(struct lyd_val_incr *incr, const struct lysc_node *snode, struct lyd_val_incr_valset **vs)
+{
+    struct lyd_val_incr_valset *mem;
+    uint32_t i;
+
+    for (i = 0; i < incr->valset_count; ++i) {
+        if (incr->valsets[i].snode == snode) {
+            *vs = &incr->valsets[i];
+            return LY_SUCCESS;
+        }
+    }
+
+    mem = realloc(incr->valsets, (incr->valset_count + 1) * sizeof *incr->valsets);
+    LY_CHECK_RET(!mem, LY_EMEM);
+    incr->valsets = mem;
+
+    *vs = &incr->valsets[incr->valset_count++];
+    memset(*vs, 0, sizeof **vs);
+    (*vs)->snode = snode;
+    return LY_SUCCESS;
+}
+
+/**
+ * @brief Remember one value the edit touched.
+ */
+static LY_ERR
+lyd_val_incr_valset_add(struct lyd_val_incr_valset *vs, const char *val)
+{
+    const char **mem;
+    uint32_t i;
+
+    if (!val) {
+        /* a node the diff carries without a value cannot be told apart from any other */
+        vs->unknown = 1;
+        return LY_SUCCESS;
+    }
+    for (i = 0; i < vs->val_count; ++i) {
+        if (!strcmp(vs->vals[i], val)) {
+            return LY_SUCCESS;
+        }
+    }
+
+    mem = realloc((void *)vs->vals, (vs->val_count + 1) * sizeof *vs->vals);
+    LY_CHECK_RET(!mem, LY_EMEM);
+    vs->vals = mem;
+    vs->vals[vs->val_count++] = val;
+    return LY_SUCCESS;
+}
+
+/**
+ * @brief Collect the values of every value-keyed node a diff node changed.
+ *
+ * A diff node that could hold an instance of a value-keyed node without spelling it out leaves the value set
+ * unusable: the tree may well hold an instance the diff does not describe.
+ */
+static LY_ERR
+lyd_val_incr_values(const struct lyd_val_dep_index *index, const struct lyd_node *diff_node,
+        struct lyd_val_incr *incr)
+{
+    const struct lysc_node *snode;
+    struct lyd_val_incr_valset *vs;
+    const struct lyd_node *elem;
+    const char *orig;
+    ly_bool found;
+    uint32_t i;
+
+    for (i = 0; i < index->value_keyed_count; ++i) {
+        snode = index->constraints[index->value_keyed[i]].snode;
+        if (!lyd_val_incr_snode_covers(diff_node->schema, snode)) {
+            /* nothing of this node can be in the changed subtree */
+            continue;
+        }
+
+        LY_CHECK_RET(lyd_val_incr_valset_get(incr, snode, &vs));
+        if (vs->unknown) {
+            continue;
+        }
+
+        found = 0;
+        LYD_TREE_DFS_BEGIN(diff_node, elem) {
+            if (elem->schema == snode) {
+                found = 1;
+                LY_CHECK_RET(lyd_val_incr_valset_add(vs, lyd_get_value(elem)));
+
+                /* a replaced instance frees its old value, which can make another instance valid */
+                orig = lyd_val_incr_orig_value(elem);
+                if (orig) {
+                    LY_CHECK_RET(lyd_val_incr_valset_add(vs, orig));
+                }
+            }
+            LYD_TREE_DFS_END(diff_node, elem);
+        }
+        if (!found) {
+            vs->unknown = 1;
+        }
+    }
+
+    return LY_SUCCESS;
+}
+
+ly_bool
+lyd_val_incr_must_skip(const struct lyd_val_incr *incr, const struct lyd_node *node, const struct lysc_must *must)
+{
+    const struct lyd_val_incr_valset *vs = NULL;
+    uint32_t i;
+
+    if (!incr || !incr->valset_count || !incr->index || !node->schema) {
+        return 0;
+    }
+
+    for (i = 0; i < incr->valset_count; ++i) {
+        if (incr->valsets[i].snode == node->schema) {
+            vs = &incr->valsets[i];
+            break;
+        }
+    }
+    if (!vs || vs->unknown) {
+        /* the edit may have changed an instance of this node without saying which value it held */
+        return 0;
+    }
+    if (!(node->schema->nodetype & LYD_NODE_TERM) ||
+            !lyd_val_deps_value_keyed(incr->index, node->schema, must->cond)) {
+        return 0;
+    }
+
+    for (i = 0; i < vs->val_count; ++i) {
+        if (!lyd_value_compare((const struct lyd_node_term *)node, vs->vals[i], strlen(vs->vals[i]))) {
+            /* the edit added or removed an instance holding this value, so the count may have changed */
+            return 0;
+        }
+    }
+
+    /* no instance holding this value appeared or disappeared, so the count this instance sees is the one it
+     * was already validated against */
+    return 1;
+}
