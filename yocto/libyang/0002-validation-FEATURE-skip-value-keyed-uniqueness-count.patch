From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oreo Yang <oreo.yang@vecima.com>
Date: Tue, 15 Sep 2026 17:00:00 +0800
Subject: [PATCH] validation FEATURE skip value-keyed uniqueness count musts

Skip re-evaluating count(path[leaf = current()]) < N on instances whose
value the edit did not touch. Shared-forwarder uniqueness stays O(N)
per apply instead of O(N^2). Dirty-root selection is unchanged.

---
diff --git a/src/ly_common.h b/src/ly_common.h
index ea10f1f..305ae67 100644
--- a/src/ly_common.h
+++ b/src/ly_common.h
@@ -376,6 +376,8 @@ struct ly_ctx {
         uint64_t fallbacks;           /**< of those, the ones that validated the whole module instead */
         uint64_t scope_roots;         /**< subtrees selected for revalidation across all calls */
         uint64_t extra_nodes;         /**< nodes revalidated because a cross-instance constraint could have changed */
+        uint64_t must_evals;          /**< "must" conditions evaluated by incremental validation */
+        uint64_t must_skips;          /**< value-keyed "must" conditions the edit could not have violated */
     } val_incr_stats;
 };
 
