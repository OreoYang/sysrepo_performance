From 13320e99135830a1087086ac6dd52236c01fa078 Mon Sep 17 00:00:00 2001
From: "Oreo.Yang" <2167young@163.com>
Date: Sat, 24 Oct 2026 14:51:52 +0800
Subject: [PATCH] validation BUGFIX harden incremental validation corners

Locate a diff node at any depth. A node more than 64 levels down was
taken for a deleted top-level instance, so nothing above it was
revalidated.

A replace in the diff without orig-value makes the value set of a
value-keyed rule unknown instead of ignoring the freed value.

Functions that turn a node-set into its first node (string, contains,
concat, ...) make a rule unsafe to skip on creation, as a node that
appears in front changes the result.

Count late fallbacks separately (lyd_validate_incr_late_stats), so a rule
that deletes data on most edits shows up.

Add tests for the deep delete, first-node functions and the default case
coming back after the explicit one is deleted.
---
 src/ly_common.h                          |   1 +
 src/parser_data.h                        |  12 ++
 src/validation_deps.c                    |   6 +-
 src/validation_incr.c                    |  40 ++++--
 tests/utests/data/test_validation_incr.c | 149 +++++++++++++++++++++++
 5 files changed, 198 insertions(+), 10 deletions(-)

diff --git a/src/ly_common.h b/src/ly_common.h
index 305ae67..cbbbc2a 100644
--- a/src/ly_common.h
+++ b/src/ly_common.h
@@ -378,6 +378,7 @@ struct ly_ctx {
         uint64_t extra_nodes;         /**< nodes revalidated because a cross-instance constraint could have changed */
         uint64_t must_evals;          /**< "must" conditions evaluated by incremental validation */
         uint64_t must_skips;          /**< value-keyed "must" conditions the edit could not have violated */
+        uint64_t late_fallbacks;      /**< fallbacks decided after the validation deleted a node itself */
     } val_incr_stats;
 };
 
diff --git a/src/parser_data.h b/src/parser_data.h
index 942a42d..86efc2c 100644
--- a/src/parser_data.h
+++ b/src/parser_data.h
@@ -573,6 +573,18 @@ LIBYANG_API_DECL LY_ERR lyd_validate_module_incr_final(struct lyd_node *tree, co
  */
 LIBYANG_API_DECL void lyd_validate_incr_stats(const struct ly_ctx *ctx, uint64_t *calls, uint64_t *fallbacks);
 
+/**
+ * @brief Read how many incremental validation fallbacks came late.
+ *
+ * A late fallback happens after the incremental passes ran, because the validation deleted a node itself (a when
+ * turned false, a default or a case replaced). They are already counted in the fallbacks of
+ * ::lyd_validate_incr_stats(); a high number here means that a rule deletes data on most edits.
+ *
+ * @param[in] ctx Context to read, NULL for the totals of the process.
+ * @param[out] late_fallbacks Late fallbacks.
+ */
+LIBYANG_API_DECL void lyd_validate_incr_late_stats(const struct ly_ctx *ctx, uint64_t *late_fallbacks);
+
 /**
  * @brief Read the "must" counters of incremental validation.
  *
diff --git a/src/validation_deps.c b/src/validation_deps.c
index a380574..3d80509 100644
--- a/src/validation_deps.c
+++ b/src/validation_deps.c
@@ -51,7 +51,11 @@ static const char *const lyd_val_dep_simple_axes[] = {
  * cannot be assumed unaffected by creations.
  */
 static const char *const lyd_val_dep_antitone_funcs[] = {
-    "count", "last", "not", "position", "string-length", "sum", NULL
+    "count", "last", "not", "position", "string-length", "sum",
+    /* these turn a node-set into the value of its first node, so a node that appears in front changes the result */
+    "bit-is-set", "ceiling", "concat", "contains", "enum-value", "floor", "lang", "local-name", "name",
+    "namespace-uri", "normalize-space", "number", "re-match", "round", "starts-with", "string", "substring",
+    "substring-after", "substring-before", "translate", NULL
 };
 
 const char *
diff --git a/src/validation_incr.c b/src/validation_incr.c
index 8d6265d..9dcc514 100644
--- a/src/validation_incr.c
+++ b/src/validation_incr.c
@@ -243,6 +243,7 @@ lyd_val_incr_values(const struct lyd_val_dep_index *index, const struct lyd_node
     struct lyd_val_incr_valset *vs;
     const struct lyd_node *elem;
     const char *orig;
+    enum lyd_diff_op op;
     ly_bool found;
     uint32_t i;
 
@@ -268,6 +269,9 @@ lyd_val_incr_values(const struct lyd_val_dep_index *index, const struct lyd_node
                 orig = lyd_val_incr_orig_value(elem);
                 if (orig) {
                     LY_CHECK_RET(lyd_val_incr_valset_add(vs, orig));
+                } else if (lyd_val_incr_diff_op(elem, &op) && (op == LYD_DIFF_OP_REPLACE)) {
+                    /* the old value is not spelled out, so which value was freed is unknown */
+                    vs->unknown = 1;
                 }
             }
             LYD_TREE_DFS_END(diff_node, elem);
@@ -331,27 +335,29 @@ lyd_val_incr_must_skip(const struct lyd_val_incr *incr, const struct lyd_node *n
 static ly_bool
 lyd_val_incr_find(const struct lyd_node *tree, const struct lyd_node *diff_node, struct lyd_node **match)
 {
-    const struct lyd_node *chain[64], *dnode;
+    const struct lyd_node *dnode, *level;
     struct lyd_node *cur = NULL, *found;
     const struct lyd_node *siblings;
-    uint32_t depth = 0, i;
+    uint32_t depth = 0, i, j;
 
     *match = NULL;
 
     for (dnode = diff_node; dnode; dnode = lyd_parent(dnode)) {
-        if (depth == (sizeof chain / sizeof *chain)) {
-            return 0;
-        }
-        chain[depth++] = dnode;
+        ++depth;
     }
-
+    /* no depth limit: a node that is too deep to match would be taken for a deleted top-level instance */
     siblings = tree;
     for (i = depth; i > 0; --i) {
-        if (!chain[i - 1]->schema) {
+        level = diff_node;
+        for (j = 1; j < i; ++j) {
+            level = lyd_parent(level);
+        }
+
+        if (!level->schema) {
             /* opaque diff node, cannot be matched reliably */
             return 0;
         }
-        if (lyd_find_sibling_first(siblings, chain[i - 1], &found) || !found) {
+        if (lyd_find_sibling_first(siblings, level, &found) || !found) {
             *match = cur;
             return 0;
         }
@@ -719,13 +725,29 @@ lyd_val_incr_count_late_fallback(const struct ly_ctx *ctx)
 
     pthread_mutex_lock(&c->val_deps_lock);
     ++c->val_incr_stats.fallbacks;
+    ++c->val_incr_stats.late_fallbacks;
     pthread_mutex_unlock(&c->val_deps_lock);
 
     pthread_mutex_lock(&lyd_val_incr_glob_lock);
     ++lyd_val_incr_glob.fallbacks;
+    ++lyd_val_incr_glob.late_fallbacks;
     pthread_mutex_unlock(&lyd_val_incr_glob_lock);
 }
 
+LIBYANG_API_DEF void
+lyd_validate_incr_late_stats(const struct ly_ctx *ctx, uint64_t *late_fallbacks)
+{
+    struct ly_ctx *c = (struct ly_ctx *)ctx;
+    pthread_mutex_t *lock = ctx ? &c->val_deps_lock : &lyd_val_incr_glob_lock;
+    const struct lyd_validate_incr_stats *stats = ctx ? &c->val_incr_stats : &lyd_val_incr_glob;
+
+    pthread_mutex_lock(lock);
+    if (late_fallbacks) {
+        *late_fallbacks = stats->late_fallbacks;
+    }
+    pthread_mutex_unlock(lock);
+}
+
 void
 lyd_val_incr_must_count(const struct ly_ctx *ctx, uint64_t evals, uint64_t skips)
 {
diff --git a/tests/utests/data/test_validation_incr.c b/tests/utests/data/test_validation_incr.c
index 541f9e8..f3ac1dc 100644
--- a/tests/utests/data/test_validation_incr.c
+++ b/tests/utests/data/test_validation_incr.c
@@ -826,6 +826,10 @@ static const char *schema_b =
         "                when \"not(/a:ifs/a:if[a:name = current()/../ifname]/b:b-cfg/b:speed < 500)\";\n"
         "                type string;\n"
         "            }\n"
+        "            leaf hi2 {\n"
+        "                when \"not(/a:ifs/a:if[a:name = current()/../ifname]/b:b-cfg/b:m1-val)\";\n"
+        "                type string;\n"
+        "            }\n"
         "        }\n"
         "    }\n"
         "}";
@@ -860,6 +864,20 @@ static const char *schema_c =
         "                type string;\n"
         "                must \"/a:ifs/a:if[a:name = current()/../ifname]/b:b-cfg/b:m1-val = 1\";\n"
         "            }\n"
+        "            leaf nom1 {\n"
+        "                type string;\n"
+        "                must \"not(/a:ifs/a:if[a:name = current()/../ifname]/b:b-cfg/b:m1-val)\";\n"
+        "            }\n"
+        /* the first ip of the interface: a node that appears in front of it changes the value, so creating data
+         * is not safe for this one, unlike the plain comparison */
+        "            leaf ipfirst {\n"
+        "                type string;\n"
+        "                must \"contains(/a:ifs/a:if[a:name = current()/../ifname]/b:b-addr/b:ip, '10.')\";\n"
+        "            }\n"
+        "            leaf ipany {\n"
+        "                type string;\n"
+        "                must \"/a:ifs/a:if[a:name = current()/../ifname]/b:b-addr/b:ip = '10.0.0.1'\";\n"
+        "            }\n"
         /* a first-pass reader of data that module b autodeletes */
         "            leaf cs { type leafref { path \"/a:ifs/a:if/b:b-cfg/b:speed\"; } }\n"
         "        }\n"
@@ -1250,6 +1268,134 @@ test_aug_dflt_replace(void **state)
     aug_done();
 }
 
+/**
+ * @brief A rule that reads the first node of a node-set is not safe to skip on creation, one that only asks
+ * whether some node matches is.
+ */
+static void
+test_aug_first_node_func(void **state)
+{
+    const struct lys_module *mod;
+    const struct lyd_val_dep_index *index;
+    const struct lyd_val_constraint *cons;
+    uint32_t i, seen = 0;
+
+    aug_setup(state);
+
+    mod = ly_ctx_get_module_implemented(UTEST_LYCTX, "c");
+    assert_int_equal(LY_SUCCESS, lyd_val_deps_get(mod, &index));
+    for (i = 0; i < index->constraint_count; ++i) {
+        cons = &index->constraints[i];
+        if (!strcmp(cons->snode->name, "ipfirst")) {
+            assert_false(cons->creation_safe);
+            ++seen;
+        } else if (!strcmp(cons->snode->name, "ipany")) {
+            assert_true(cons->creation_safe);
+            ++seen;
+        }
+    }
+    assert_int_equal(2, seen);
+
+    aug_done();
+}
+
+#define DEEP_LEVELS 70
+
+/**
+ * @brief A node deeper than the ancestor chain of the diff lookup used to be taken for a deleted top-level
+ * instance, so nothing above it was revalidated.
+ */
+static void
+test_aug_deep_delete(void **state)
+{
+    char schema[8192] = "module deep {\n    namespace urn:tests:deep;\n    prefix deep;\n    yang-version 1.1;\n";
+    char path[4096] = "", xml[4096] = "", del[4096] = "-", tmp[64];
+    struct lyd_node *before, *after;
+    const char *edit[] = {del, NULL, NULL, NULL};
+    uint64_t fb_before = 0, fb_after = 0;
+    LY_ERR rc;
+    int i;
+
+    /* only list instances can be left out of a scoped pass, so the deep node sits below one */
+    strcat(schema, "list l {\nkey k;\nleaf k { type string; }\n");
+    for (i = 1; i < DEEP_LEVELS; ++i) {
+        snprintf(tmp, sizeof tmp, "container c%d {\n", i);
+        strcat(schema, tmp);
+    }
+    strcat(schema, "leaf x { type string; }\nleaf m { type string; mandatory true; }\n");
+    for (i = 1; i < DEEP_LEVELS; ++i) {
+        strcat(schema, "}\n");
+    }
+    strcat(schema, "}\n}\n");
+
+    UTEST_ADD_MODULE(schema, LYS_IN_YANG, NULL, NULL);
+    check_mods[0] = "deep";
+    check_mods[1] = NULL;
+
+    strcpy(path, "/deep:l[k='1']");
+    for (i = 1; i < DEEP_LEVELS; ++i) {
+        snprintf(tmp, sizeof tmp, "/c%d", i);
+        strcat(path, tmp);
+    }
+    for (rc = 0; rc < 2; ++rc) {
+        strcat(xml, rc ? "<l xmlns=\"urn:tests:deep\"><k>2</k>" : "<l xmlns=\"urn:tests:deep\"><k>1</k>");
+        for (i = 1; i < DEEP_LEVELS; ++i) {
+            snprintf(tmp, sizeof tmp, "<c%d>", i);
+            strcat(xml, tmp);
+        }
+        strcat(xml, "<x>1</x><m>2</m>");
+        for (i = DEEP_LEVELS - 1; i >= 1; --i) {
+            snprintf(tmp, sizeof tmp, "</c%d>", i);
+            strcat(xml, tmp);
+        }
+        strcat(xml, "</l>");
+    }
+    strcat(del, path);
+    strcat(del, "/m");
+
+    before = parse_valid(state, xml);
+    after = aug_apply(state, before, edit);
+    lyd_validate_incr_stats(UTEST_LYCTX, NULL, &fb_before);
+    check_same(state, before, after, 1, &rc);
+    lyd_validate_incr_stats(UTEST_LYCTX, NULL, &fb_after);
+    /* the mandatory leaf is gone, full validation says so and the incremental one has to as well, without
+     * giving up: the lookup has to find the deleted node's parent */
+    assert_int_equal(LY_EVALID, rc);
+    assert_int_equal(fb_before, fb_after);
+
+    lyd_free_siblings(after);
+    lyd_free_siblings(before);
+    check_mods[0] = "a";
+}
+
+/**
+ * @brief Probe: the edit deletes the explicit case, so the validation brings the default case back.
+ */
+static void
+test_aug_dflt_case_back(void **state)
+{
+    struct lyd_node *before, *start;
+    const char *setup_must[] = {"/a:ifs/if[name='e1']/b:b-cfg/m2-val", "5",
+        "/c:c-refs/c-ref[name='r7']/ifname", "e1", "/c:c-refs/c-ref[name='r7']/nom1", "y", NULL, NULL};
+    const char *setup_when[] = {"/a:ifs/if[name='e1']/b:b-cfg/m2-val", "5",
+        "/b:b-top/b-chk[name='k5']/ifname", "e1", "/b:b-top/b-chk[name='k5']/hi2", "y", NULL, NULL};
+    const char *del_m2[] = {"-/a:ifs/a:if[a:name='e1']/b:b-cfg/b:m2-val", NULL, NULL, NULL};
+
+    aug_setup(state);
+    before = parse_valid(state, aug_xml);
+
+    start = aug_start(state, before, setup_must);
+    aug_check_multi(state, start, del_m2, LY_EVALID);
+    lyd_free_siblings(start);
+
+    start = aug_start(state, before, setup_when);
+    aug_check_multi(state, start, del_m2, LY_SUCCESS);
+    lyd_free_siblings(start);
+
+    lyd_free_siblings(before);
+    aug_done();
+}
+
 /**
  * @brief The default case is replaced inside a container that only existed as a default.
  *
@@ -1601,6 +1747,9 @@ main(void)
         UTEST(test_aug_when_create),
         UTEST(test_aug_dflt_replace),
         UTEST(test_aug_dflt_case_in_dflt),
+        UTEST(test_aug_dflt_case_back),
+        UTEST(test_aug_first_node_func),
+        UTEST(test_aug_deep_delete),
         UTEST(test_aug_module_order),
         UTEST(test_aug_instance_identifier),
         UTEST(test_aug_random_edits),
-- 
