+/**
+ * @brief Functions whose result depends only on the node sets of their arguments, which are analysed separately.
+ *
+ * Anything not listed here makes the whole expression unanalysable.
+ */
+static const char *const lyd_val_dep_pure_funcs[] = {
+    "bit-is-set", "boolean", "ceiling", "concat", "contains", "count", "derived-from", "derived-from-or-self",
+    "enum-value", "false", "floor", "lang", "last", "local-name", "name", "namespace-uri", "normalize-space",
+    "not", "number", "position", "re-match", "round", "starts-with", "string", "string-length", "substring",
+    "substring-after", "substring-before", "sum", "translate", "true", NULL
+};
+
+/**
+ * @brief Axes that only ever reach a bounded, statically known set of schema nodes.
+ *
+ * The upward axes are included because walking up from the context node follows a single instance chain;
+ * the downward and sibling axes are not, they behave like '//'.
+ */
+static const char *const lyd_val_dep_simple_axes[] = {
+    "ancestor", "ancestor-or-self", "attribute", "child", "parent", "self", NULL
+};
+
+/**
+ * @brief Functions whose result can go from true to false when nodes appear, so an expression using them
+ * cannot be assumed unaffected by creations.
+ */
+static const char *const lyd_val_dep_antitone_funcs[] = {
+    "count", "last", "not", "position", "string-length", "sum", NULL
+};
+
+const char *
+lyd_val_dep_class_str(enum lyd_val_dep_class cls)
+{
+    switch (cls) {
+    case LYD_VAL_DEP_LOCAL:
+        return "local";
+    case LYD_VAL_DEP_LIST_SCOPE:
+        return "list-scope";
+    case LYD_VAL_DEP_BOUNDED:
+        return "bounded";
+    case LYD_VAL_DEP_UNBOUNDED:
+        return "unbounded";
+    }
+    return "unbounded";
+}
+
+const char *
+lyd_val_dep_kind_str(enum lyd_val_dep_kind kind)
+{
+    switch (kind) {
+    case LYD_VAL_DEP_WHEN:
+        return "when";
+    case LYD_VAL_DEP_MUST:
+        return "must";
+    case LYD_VAL_DEP_LEAFREF:
+        return "leafref";
+    case LYD_VAL_DEP_UNIQUE:
+        return "unique";
+    }
+    return "?";
+}
+
+/**
+ * @brief Compare a token against a NULL-terminated list of names.
+ */
+static ly_bool
+lyd_val_dep_tok_in(const struct lyxp_expr *expr, uint32_t tok, const char *const *names)
+{
+    const char *str = expr->expr + expr->tok_pos[tok];
+    uint32_t len = expr->tok_len[tok];
+    uint32_t i;
+
+    for (i = 0; names[i]; ++i) {
+        if ((strlen(names[i]) == len) && !strncmp(names[i], str, len)) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static ly_bool
+lyd_val_dep_tok_is(const struct lyxp_expr *expr, uint32_t tok, const char *name)
+{
+    const char *str = expr->expr + expr->tok_pos[tok];
+    uint32_t len = expr->tok_len[tok];
+
+    return (strlen(name) == len) && !strncmp(name, str, len);
+}
+
+/**
+ * @brief Whether a token starts a new path expression, so a following '/' means an absolute path.
+ */
+static ly_bool
+lyd_val_dep_path_start(const struct lyxp_expr *expr, uint32_t tok)
+{
+    if (!tok) {
+        return 1;
+    }
+
+    switch (expr->tokens[tok - 1]) {
+    case LYXP_TOKEN_PAR1:
+    case LYXP_TOKEN_BRACK1:
+    case LYXP_TOKEN_COMMA:
+    case LYXP_TOKEN_OPER_LOG:
+    case LYXP_TOKEN_OPER_EQUAL:
+    case LYXP_TOKEN_OPER_NEQUAL:
+    case LYXP_TOKEN_OPER_COMP:
+    case LYXP_TOKEN_OPER_MATH:
+    case LYXP_TOKEN_OPER_UNI:
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+/**
+ * @brief Static shape of an expression, learnt from its token stream alone.
+ */
+struct lyd_val_dep_shape {
+    ly_bool blocked;        /**< contains a construct that cannot be reduced to a finite set of nodes */
+    ly_bool abs_path;       /**< contains an absolute location path */
+    ly_bool current;        /**< calls current() */
+    ly_bool deref;          /**< calls deref() */
+    ly_bool antitone;       /**< contains negation or node counting, so appearing nodes can violate it */
+    ly_bool predicates;     /**< contains at least one predicate */
+};
+
+/**
+ * @brief Whether an absolute location path starts anywhere in a token range.
+ */
+static ly_bool
+lyd_val_dep_span_has_abs(const struct lyxp_expr *expr, uint32_t from, uint32_t to)
+{
+    uint32_t i;
+
+    for (i = from; (i < to) && (i < expr->used); ++i) {
+        if ((expr->tokens[i] == LYXP_TOKEN_OPER_PATH) && lyd_val_dep_path_start(expr, i)) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/**
+ * @brief Index just past the argument list of a function call starting at @p tok.
+ */
+static uint32_t
+lyd_val_dep_call_end(const struct lyxp_expr *expr, uint32_t tok)
+{
+    uint32_t i, depth = 0;
+
+    for (i = tok + 1; i < expr->used; ++i) {
+        if (expr->tokens[i] == LYXP_TOKEN_PAR1) {
+            ++depth;
+        } else if (expr->tokens[i] == LYXP_TOKEN_PAR2) {
+            if (--depth == 0) {
+                return i;
+            }
+        }
+    }
+    return expr->used;
+}
+
+/**
+ * @brief Token range of the boolean operand around @p tok, delimited by 'and'/'or', brackets and commas.
+ */
+static void
+lyd_val_dep_operand_span(const struct lyxp_expr *expr, uint32_t tok, uint32_t *from, uint32_t *to)
+{
+    int32_t depth = 0;
+    uint32_t i;
+
+    *from = 0;
+    for (i = tok; i > 0; --i) {
+        switch (expr->tokens[i - 1]) {
+        case LYXP_TOKEN_PAR2:
+        case LYXP_TOKEN_BRACK2:
+            ++depth;
+            break;
+        case LYXP_TOKEN_PAR1:
+        case LYXP_TOKEN_BRACK1:
+            if (!depth) {
+                *from = i;
+                goto forward;
+            }
+            --depth;
+            break;
+        case LYXP_TOKEN_COMMA:
+        case LYXP_TOKEN_OPER_LOG:
+            if (!depth) {
+                *from = i;
+                goto forward;
+            }
+            break;
+        default:
+            break;
+        }
+    }
+
+forward:
+    depth = 0;
+    *to = expr->used;
+    for (i = tok + 1; i < expr->used; ++i) {
+        switch (expr->tokens[i]) {
+        case LYXP_TOKEN_PAR1:
+        case LYXP_TOKEN_BRACK1:
+            ++depth;
+            break;
+        case LYXP_TOKEN_PAR2:
+        case LYXP_TOKEN_BRACK2:
+            if (!depth) {
+                *to = i;
+                return;
+            }
+            --depth;
+            break;
+        case LYXP_TOKEN_COMMA:
+        case LYXP_TOKEN_OPER_LOG:
+            if (!depth) {
+                *to = i;
+                return;
+            }
+            break;
+        default:
+            break;
+        }
+    }
+}
+
+static void
+lyd_val_dep_shape_scan(const struct lyxp_expr *expr, struct lyd_val_dep_shape *shape)
+{
+    uint32_t i;
+    const char *str;
+    uint32_t len;
+
+    memset(shape, 0, sizeof *shape);
+
+    for (i = 0; i < expr->used; ++i) {
+        switch (expr->tokens[i]) {
+        case LYXP_TOKEN_OPER_RPATH:
+        case LYXP_TOKEN_NODETYPE:
+        case LYXP_TOKEN_VARREF:
+            /* '//', node()/text() and variables all reach an unbounded set of nodes */
+            shape->blocked = 1;
+            return;
+        case LYXP_TOKEN_AXISNAME:
+            if (!lyd_val_dep_tok_in(expr, i, lyd_val_dep_simple_axes)) {
+                shape->blocked = 1;
+                return;
+            }
+            break;
+        case LYXP_TOKEN_NAMETEST:
+            str = expr->expr + expr->tok_pos[i];
+            len = expr->tok_len[i];
+            if (str[len - 1] == '*') {
+                /* '*' or 'pfx:*' */
+                shape->blocked = 1;
+                return;
+            }
+            break;
+        case LYXP_TOKEN_FUNCNAME:
+            if (lyd_val_dep_tok_is(expr, i, "current")) {
+                shape->current = 1;
+            } else if (lyd_val_dep_tok_is(expr, i, "deref")) {
+                shape->deref = 1;
+                shape->antitone = 1;
+            } else if (!lyd_val_dep_tok_in(expr, i, lyd_val_dep_pure_funcs)) {
+                shape->blocked = 1;
+                return;
+            }
+            if (lyd_val_dep_tok_in(expr, i, lyd_val_dep_antitone_funcs) &&
+                    lyd_val_dep_span_has_abs(expr, i, lyd_val_dep_call_end(expr, i))) {
+                /* negating or counting something reachable only from the data root; nodes appearing
+                 * elsewhere in the tree can flip the result */
+                shape->antitone = 1;
+            }
+            break;
+        case LYXP_TOKEN_OPER_NEQUAL: {
+            uint32_t from, to;
+
+            lyd_val_dep_operand_span(expr, i, &from, &to);
+            if (lyd_val_dep_span_has_abs(expr, from, to)) {
+                shape->antitone = 1;
+            }
+            break;
+        }
+        case LYXP_TOKEN_BRACK1:
+            shape->predicates = 1;
+            break;
+        case LYXP_TOKEN_OPER_PATH:
+            if (lyd_val_dep_path_start(expr, i)) {
+                shape->abs_path = 1;
+            }
+            break;
+        default:
+            break;
+        }
+    }
+}
+
+/**
+ * @brief Depth of a schema node in the data tree, 1 for top-level nodes.
+ */
+static uint32_t
+lyd_val_dep_depth(const struct lysc_node *snode)
+{
+    uint32_t depth = 0;
+
+    while (snode) {
+        ++depth;
+        snode = lysc_data_parent(snode);
+    }
+    return depth;
+}
+
+static ly_bool
+lyd_val_dep_is_ancestor(const struct lysc_node *anc, const struct lysc_node *snode)
+{
+    while (snode) {
+        if (snode == anc) {
+            return 1;
+        }
+        snode = lysc_data_parent(snode);
+    }
+    return 0;
+}
+
+/**
+ * @brief Lowest common data ancestor of two schema nodes, NULL if they only meet at the tree root.
+ */
+static const struct lysc_node *
+lyd_val_dep_lca(const struct lysc_node *n1, const struct lysc_node *n2)
+{
+    uint32_t d1 = lyd_val_dep_depth(n1), d2 = lyd_val_dep_depth(n2);
+
+    while (d1 > d2) {
+        n1 = lysc_data_parent(n1);
+        --d1;
+    }
+    while (d2 > d1) {
+        n2 = lysc_data_parent(n2);
+        --d2;
+    }
+    while (n1 != n2) {
+        n1 = lysc_data_parent(n1);
+        n2 = lysc_data_parent(n2);
+    }
+    return n1;
+}
+
+/**
+ * @brief Whether reaching @p snode from @p lca passes through a list or leaf-list, meaning the step
+ * yields a whole set of instances instead of at most one.
+ */
+static ly_bool
+lyd_val_dep_crosses_list(const struct lysc_node *lca, const struct lysc_node *snode)
+{
+    while (snode && (snode != lca)) {
+        if (snode->nodetype & (LYS_LIST | LYS_LEAFLIST)) {
+            return 1;
+        }
+        snode = lysc_data_parent(snode);
+    }
+    return 0;
+}
+
+/**
+ * @brief Whether every predicate in the expression selects instances by a list key.
+ *
+ * Only key predicates make a target instance immune to creations: a new list instance always carries a key
+ * value that no existing referrer can already be pointing at.
+ */
+static ly_bool
+lyd_val_dep_preds_are_keys(const struct lyxp_expr *expr, const struct ly_set *atoms)
+{
+    const char *name;
+    uint32_t i, j, len;
+    ly_bool matched;
+
+    for (i = 0; i + 1 < expr->used; ++i) {
+        if (expr->tokens[i] != LYXP_TOKEN_BRACK1) {
+            continue;
+        }
+        if (expr->tokens[i + 1] != LYXP_TOKEN_NAMETEST) {
+            /* positional or otherwise non-key predicate */
+            return 0;
+        }
+
+        /* drop the prefix, atoms are matched by their local name */
+        name = expr->expr + expr->tok_pos[i + 1];
+        len = expr->tok_len[i + 1];
+        for (j = 0; j < len; ++j) {
+            if (name[j] == ':') {
+                name += j + 1;
+                len -= j + 1;
+                break;
+            }
+        }
+
+        matched = 0;
+        for (j = 0; j < atoms->count; ++j) {
+            const struct lysc_node *atom = atoms->snodes[j];
+
+            if (!atom || (strlen(atom->name) != len) || strncmp(atom->name, name, len)) {
+                continue;
+            }
+            if (!(atom->flags & LYS_KEY)) {
+                return 0;
+            }
+            matched = 1;
+        }
+        if (!matched) {
+            return 0;
+        }
+    }
+
+    return 1;
+}
+
+enum lyd_val_dep_class
+lyd_val_dep_classify_expr(const struct lysc_node *ctx_node, const struct lys_module *cur_mod,
+        const struct lyxp_expr *expr, const struct lysc_prefix *prefixes, struct ly_set **atoms,
+        ly_bool *creation_safe, const struct lysc_node **unit)
+{
+    struct lyd_val_dep_shape shape;
+    struct ly_set *set = NULL;
+    const struct lysc_node *region, *lca, *iter, *atom;
+    ly_bool crosses_list = 0;
+    uint32_t i;
+
+    if (atoms) {
+        *atoms = NULL;
+    }
+    if (creation_safe) {
+        *creation_safe = 0;
+    }
+    if (unit) {
+        *unit = NULL;
+    }
+    if (!expr) {
+        return LYD_VAL_DEP_UNBOUNDED;
+    }
+
+    lyd_val_dep_shape_scan(expr, &shape);
+
+    /* the atoms are needed even for expressions we cannot classify, the caller uses them to decide whether
+     * an edit could have changed the result at all */
+    if (lys_find_expr_atoms(ctx_node, cur_mod, expr, prefixes, LYS_FIND_XP_SCHEMA, &set)) {
+        ly_set_free(set, NULL);
+        return LYD_VAL_DEP_UNBOUNDED;
+    }
+    if (atoms) {
+        *atoms = set;
+    }
+
+    if (shape.blocked) {
+        goto unbounded;
+    }
+    if (shape.abs_path || shape.deref) {
+        /* leaves the context instance; only usable if the target instance is picked by a key predicate */
+        goto cross_instance;
+    }
+    if (!ctx_node) {
+        /* evaluated from the data root, every step is cross-instance */
+        goto cross_instance;
+    }
+
+    region = ctx_node;
+    for (i = 0; i < set->count; ++i) {
+        atom = set->snodes[i];
+        if (!atom) {
+            continue;
+        }
+
+        lca = lyd_val_dep_lca(atom, ctx_node);
+        if (!lca) {
+            /* the expression walks above the top-level node it started from */
+            goto cross_instance;
+        }
+        if (!lyd_val_dep_is_ancestor(atom, ctx_node) && lyd_val_dep_crosses_list(lca, atom)) {
+            crosses_list = 1;
+        }
+        region = lyd_val_dep_lca(region, lca);
+        if (!region) {
+            goto cross_instance;
+        }
+    }
+
+    /* the deepest list instance that contains the whole region is what confines this constraint */
+    for (iter = region; iter; iter = lysc_data_parent(iter)) {
+        if (iter->nodetype == LYS_LIST) {
+            break;
+        }
+    }
+    if (!iter) {
+        /* no list confines the region; that is only safe if the context node itself is not inside a list,
+         * otherwise the expression spans every sibling instance */
+        for (atom = ctx_node; atom; atom = lysc_data_parent(atom)) {
+            if (atom->nodetype == LYS_LIST) {
+                goto cross_instance;
+            }
+        }
+        /* confined to the top-level instance only */
+    }
+    if (unit) {
+        *unit = iter;
+    }
+
+    return crosses_list ? LYD_VAL_DEP_LIST_SCOPE : LYD_VAL_DEP_LOCAL;
+
+cross_instance:
+    if (shape.blocked) {
+        goto unbounded;
+    }
+    if (!shape.current && !shape.deref) {
+        goto unbounded;
+    }
+    if (creation_safe && !shape.antitone && shape.predicates && lyd_val_dep_preds_are_keys(expr, set)) {
+        *creation_safe = 1;
+    }
+    return LYD_VAL_DEP_BOUNDED;
+
+unbounded:
+    return LYD_VAL_DEP_UNBOUNDED;
+}
+
+/**
+ * @brief Turn an atom set into a NULL-terminated array owned by the index.
+ */
+static LY_ERR
+lyd_val_dep_atoms_store(struct ly_set *set, const struct lysc_node ***atoms_p)
+{
+    const struct lysc_node **atoms;
+    uint32_t i, count = 0;
+
+    atoms = calloc(set ? set->count + 1 : 1, sizeof *atoms);
+    if (!atoms) {
+        return LY_EMEM;
+    }
+    for (i = 0; set && (i < set->count); ++i) {
+        if (set->snodes[i]) {
+            atoms[count++] = set->snodes[i];
+        }
+    }
+    atoms[count] = NULL;
+    *atoms_p = atoms;
+    return LY_SUCCESS;
+}
+
+static LY_ERR
+lyd_val_dep_add(struct lyd_val_dep_index *index, const struct lysc_node *snode, enum lyd_val_dep_kind kind,
+        enum lyd_val_dep_class cls, ly_bool creation_safe, const struct lysc_node *unit, const char *expr,
+        struct ly_set *atom_set)
+{
+    struct lyd_val_constraint *c, *mem;
+    uint32_t *nl, i;
+
+    mem = realloc(index->constraints, (index->constraint_count + 1) * sizeof *index->constraints);
+    if (!mem) {
+        return LY_EMEM;
+    }
+    index->constraints = mem;
+
+    c = &index->constraints[index->constraint_count];
+    memset(c, 0, sizeof *c);
+    c->snode = snode;
+    c->kind = kind;
+    c->cls = cls;
+    c->creation_safe = creation_safe;
+    c->unit = unit;
+    c->expr = expr;
+    LY_CHECK_RET(lyd_val_dep_atoms_store(atom_set, &c->atoms));
+
+    if ((cls == LYD_VAL_DEP_BOUNDED) || (cls == LYD_VAL_DEP_UNBOUNDED)) {
+        nl = realloc(index->nonlocal, (index->nonlocal_count + 1) * sizeof *index->nonlocal);
+        if (!nl) {
+            return LY_EMEM;
+        }
+        index->nonlocal = nl;
+        index->nonlocal[index->nonlocal_count++] = index->constraint_count;
+    } else if (!unit) {
+        for (i = 0; c->atoms[i]; ++i) {
+            LY_CHECK_RET(ly_set_add(&index->toplevel_atoms, (void *)c->atoms[i], 0, NULL));
+        }
+    }
+
+    ++index->class_count[cls];
+    ++index->constraint_count;
+    return LY_SUCCESS;
+}
+
+/**
+ * @brief Classify every leafref inside a (possibly union) type.
+ */
+static LY_ERR
+lyd_val_dep_add_leafrefs(struct lyd_val_dep_index *index, const struct lysc_node *snode, const struct lysc_type *type)
+{
+    const struct lysc_type_leafref *lref;
+    const struct lysc_type_union *uni;
+    struct ly_set *atom_set = NULL;
+    const struct lysc_node *unit;
+    enum lyd_val_dep_class cls;
+    LY_ARRAY_COUNT_TYPE u;
+    LY_ERR rc;
+
+    switch (type->basetype) {
+    case LY_TYPE_LEAFREF:
+        lref = (const struct lysc_type_leafref *)type;
+        if (!lref->require_instance) {
+            /* nothing is checked against the data tree */
+            return LY_SUCCESS;
+        }
+        cls = lyd_val_dep_classify_expr(snode, snode->module, lref->path, lref->prefixes, &atom_set, NULL, &unit);
+
+        /* a require-instance leafref only asks whether some node in the target set carries this value, and
+         * creating data can only add to that set, so no creation can invalidate an existing leafref */
+        rc = lyd_val_dep_add(index, snode, LYD_VAL_DEP_LEAFREF, cls, atom_set ? 1 : 0, unit,
+                lref->path ? lref->path->expr : "", atom_set);
+        ly_set_free(atom_set, NULL);
+        return rc;
+    case LY_TYPE_UNION:
+        uni = (const struct lysc_type_union *)type;
+        LY_ARRAY_FOR(uni->types, u) {
+            LY_CHECK_RET(lyd_val_dep_add_leafrefs(index, snode, uni->types[u]));
+        }
+        return LY_SUCCESS;
+    default:
+        return LY_SUCCESS;
+    }
+}
+
+/**
+ * @brief Whether a node can appear in the data without anyone asking for it.
+ */
+static ly_bool
+lyd_val_dep_is_implicit(const struct lysc_node *snode)
+{
+    switch (snode->nodetype) {
+    case LYS_LEAF:
+        return ((const struct lysc_node_leaf *)snode)->dflt ? 1 : 0;
+    case LYS_LEAFLIST:
+        return ((const struct lysc_node_leaflist *)snode)->dflts ? 1 : 0;
+    case LYS_CONTAINER:
+        return (snode->flags & LYS_PRESENCE) ? 0 : 1;
+    default:
+        return 0;
+    }
+}
+
+static LY_ERR
+lyd_val_dep_add_node(struct lyd_val_dep_index *index, const struct lysc_node *snode)
+{
+    struct lysc_when **whens;
+    struct lysc_must *musts;
+    struct ly_set *atom_set = NULL;
+    const struct lysc_node *unit;
+    enum lyd_val_dep_class cls;
+    ly_bool creation_safe;
+    LY_ARRAY_COUNT_TYPE u;
+    LY_ERR rc = LY_SUCCESS;
+
+    whens = lysc_node_when(snode);
+    if (whens && lyd_val_dep_is_implicit(snode)) {
+        LY_CHECK_RET(ly_set_add(&index->dflt_when, (void *)snode, 0, NULL));
+    }
+    LY_ARRAY_FOR(whens, u) {
+        cls = lyd_val_dep_classify_expr(whens[u]->context, snode->module, whens[u]->cond, whens[u]->prefixes,
+                &atom_set, &creation_safe, &unit);
+        rc = lyd_val_dep_add(index, snode, LYD_VAL_DEP_WHEN, cls, creation_safe, unit, whens[u]->cond->expr, atom_set);
+        ly_set_free(atom_set, NULL);
+        LY_CHECK_RET(rc);
+    }
+
+    musts = lysc_node_musts(snode);
+    LY_ARRAY_FOR(musts, u) {
+        cls = lyd_val_dep_classify_expr(snode, snode->module, musts[u].cond, musts[u].prefixes,
+                &atom_set, &creation_safe, &unit);
+        rc = lyd_val_dep_add(index, snode, LYD_VAL_DEP_MUST, cls, creation_safe, unit, musts[u].cond->expr, atom_set);
+        ly_set_free(atom_set, NULL);
+        LY_CHECK_RET(rc);
+    }
+
+    if (snode->nodetype & LYD_NODE_TERM) {
+        LY_CHECK_RET(lyd_val_dep_add_leafrefs(index, snode, ((const struct lysc_node_leaf *)snode)->type));
+    }
+
+    if (snode->nodetype == LYS_LIST) {
+        const struct lysc_node_list *slist = (const struct lysc_node_list *)snode;
+
+        /* a unique spans the instances of one list under one parent, so it is confined by the first list above
+         * that parent; the scoped final pass runs the sibling checks of every parent it descends through, so a
+         * unique is always rechecked without needing any atoms of its own */
+        for (unit = lysc_data_parent(snode); unit; unit = lysc_data_parent(unit)) {
+            if (unit->nodetype == LYS_LIST) {
+                break;
+            }
+        }
+        LY_ARRAY_FOR(slist->uniques, u) {
+            LY_CHECK_RET(lyd_val_dep_add(index, snode, LYD_VAL_DEP_UNIQUE, LYD_VAL_DEP_LIST_SCOPE, 1, unit,
+                    "unique", NULL));
+        }
+    }
+
+    return LY_SUCCESS;
+}
+
+static void
+lyd_val_dep_index_free(struct lyd_val_dep_index *index)
+{
+    uint32_t i;
+
+    if (!index) {
+        return;
+    }
+    for (i = 0; i < index->constraint_count; ++i) {
+        free((void *)index->constraints[i].atoms);
+    }
+    free(index->constraints);
+    free(index->nonlocal);
+    ly_set_erase(&index->toplevel_atoms, NULL);
+    ly_set_erase(&index->dflt_when, NULL);
+    free(index);
+}
+
+static LY_ERR
+lyd_val_dep_index_build(const struct lys_module *mod, struct lyd_val_dep_index **index_p)
+{
+    struct lyd_val_dep_index *index;
+    const struct lysc_node *snode, *root;
+    LY_ERR rc = LY_SUCCESS;
+
+    index = calloc(1, sizeof *index);
+    LY_CHECK_ERR_RET(!index, LOGMEM(mod->ctx), LY_EMEM);
+    index->mod = mod;
+
+    if (!mod->compiled) {
+        goto cleanup;
+    }
+
+    LY_LIST_FOR(mod->compiled->data, root) {
+        const struct lysc_node *elem;
+
+        LYSC_TREE_DFS_BEGIN(root, elem) {
+            rc = lyd_val_dep_add_node(index, elem);
+            LY_CHECK_GOTO(rc, cleanup);
+            LYSC_TREE_DFS_END(root, elem);
+        }
+    }
+
+    /* RPC/action/notification data are validated separately, but their constraints still belong to the module */
+    LY_LIST_FOR((const struct lysc_node *)mod->compiled->rpcs, snode) {
+        rc = lyd_val_dep_add_node(index, snode);
+        LY_CHECK_GOTO(rc, cleanup);
+    }
+    LY_LIST_FOR((const struct lysc_node *)mod->compiled->notifs, snode) {
+        rc = lyd_val_dep_add_node(index, snode);
+        LY_CHECK_GOTO(rc, cleanup);
+    }
+
+cleanup:
+    if (rc) {
+        lyd_val_dep_index_free(index);
+        return rc;
+    }
+    *index_p = index;
+    return LY_SUCCESS;
+}
+
+LY_ERR
+lyd_val_deps_get(const struct lys_module *mod, const struct lyd_val_dep_index **index)
+{
+    struct ly_ctx *ctx = mod->ctx;
+    struct lyd_val_dep_index *built = NULL, **mem;
+    uint32_t i;
+    LY_ERR rc = LY_SUCCESS;
+
+    pthread_mutex_lock(&ctx->val_deps_lock);
+
+    for (i = 0; i < ctx->val_deps_count; ++i) {
+        if (ctx->val_deps[i]->mod == mod) {
+            *index = ctx->val_deps[i];
+            goto cleanup;
+        }
+    }
+
+    rc = lyd_val_dep_index_build(mod, &built);
+    LY_CHECK_GOTO(rc, cleanup);
+
+    mem = realloc(ctx->val_deps, (ctx->val_deps_count + 1) * sizeof *ctx->val_deps);
+    if (!mem) {
+        lyd_val_dep_index_free(built);
+        rc = LY_EMEM;
+        goto cleanup;
+    }
+    ctx->val_deps = mem;
+    ctx->val_deps[ctx->val_deps_count++] = built;
+    *index = built;
+
+cleanup:
+    pthread_mutex_unlock(&ctx->val_deps_lock);
+    return rc;
+}
+
+void
+lyd_val_deps_ctx_free(struct ly_ctx *ctx)
+{
+    uint32_t i;
+
+    for (i = 0; i < ctx->val_deps_count; ++i) {
+        lyd_val_dep_index_free(ctx->val_deps[i]);
+    }
+    free(ctx->val_deps);
+    ctx->val_deps = NULL;
+    ctx->val_deps_count = 0;
+}
diff --git a/src/validation_deps.h b/src/validation_deps.h
new file mode 100644
index 0000000..6bee7b3
--- /dev/null
+++ b/src/validation_deps.h
@@ -0,0 +1,166 @@
+/**
+ * @file validation_deps.h
+ * @brief Dependency classification and indexing for incremental validation.
+ *
+ * Copyright (c) 2026 Vecima Networks Inc.
+ *
+ * This source code is licensed under BSD 3-Clause License (the "License").
+ * You may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     https://opensource.org/licenses/BSD-3-Clause
+ */
+
+#ifndef LY_VALIDATION_DEPS_H_
+#define LY_VALIDATION_DEPS_H_
+
+#include <stdint.h>
+
+#include "log.h"
+#include "set.h"
+#include "tree.h"
+
+struct ly_ctx;
+struct lys_module;
+struct lysc_node;
+struct lysc_prefix;
+struct lyxp_expr;
+
+/**
+ * @brief How far the data a constraint reads can reach.
+ *
+ * The unit of reasoning is the *top-level data instance*: the subtree rooted at the topmost data node
+ * containing the constrained node. An edit that does not touch a given top-level instance cannot change
+ * the result of a ::LYD_VAL_DEP_LOCAL or ::LYD_VAL_DEP_LIST_SCOPE constraint evaluated inside it.
+ */
+enum lyd_val_dep_class {
+    LYD_VAL_DEP_LOCAL = 0,      /**< reads only the constraint's own instance and its ancestors */
+    LYD_VAL_DEP_LIST_SCOPE,     /**< reads a whole nested list, but still inside the same top-level instance */
+    LYD_VAL_DEP_BOUNDED,        /**< reaches other top-level instances, but only ones selected by key
+                                     predicates driven by current() or by deref() */
+    LYD_VAL_DEP_UNBOUNDED       /**< cannot be reduced to a finite set of instances */
+};
+
+#define LYD_VAL_DEP_CLASS_COUNT 4
+
+/**
+ * @brief Why a constraint exists, only used for reporting.
+ */
+enum lyd_val_dep_kind {
+    LYD_VAL_DEP_WHEN = 0,
+    LYD_VAL_DEP_MUST,
+    LYD_VAL_DEP_LEAFREF,
+    LYD_VAL_DEP_UNIQUE
+};
+
+/**
+ * @brief One classified constraint.
+ */
+struct lyd_val_constraint {
+    const struct lysc_node *snode;      /**< node the constraint is attached to */
+    const char *expr;                   /**< expression text, not owned */
+    const struct lysc_node **atoms;     /**< NULL-terminated schema nodes the expression reads */
+    enum lyd_val_dep_kind kind;
+    enum lyd_val_dep_class cls;
+
+    /**
+     * @brief Whether creating data can never turn this constraint from satisfied to violated.
+     *
+     * True for require-instance leafrefs, whose check is a pure existence test over a node set that
+     * creation can only grow, and for cross-instance when/must that select their target through list key
+     * predicates and combine the results without negation: a created list instance necessarily carries a
+     * new key, so it cannot become the target of an already existing referrer, and an existing referrer
+     * that selected nothing would already have been rejected before the edit.
+     */
+    ly_bool creation_safe;
+
+    /**
+     * @brief List instance the constraint is confined to, NULL for the whole top-level instance.
+     *
+     * Only meaningful for ::LYD_VAL_DEP_LOCAL and ::LYD_VAL_DEP_LIST_SCOPE.
+     */
+    const struct lysc_node *unit;
+};
+
+/**
+ * @brief Per-module classification of every constraint reachable from the module's compiled tree.
+ *
+ * Built lazily, cached in the context, freed with the context.
+ */
+struct lyd_val_dep_index {
+    const struct lys_module *mod;
+    struct lyd_val_constraint *constraints;
+    uint32_t constraint_count;
+
+    uint32_t *nonlocal;                 /**< indices of ::LYD_VAL_DEP_BOUNDED / ::LYD_VAL_DEP_UNBOUNDED constraints */
+    uint32_t nonlocal_count;
+
+    /**
+     * @brief Schema nodes read by a constraint that no list confines.
+     *
+     * Touching one of these means the revalidated subtree has to be the whole top-level instance; every other
+     * confined constraint is covered by revalidating the topmost list instance around the change.
+     */
+    struct ly_set toplevel_atoms;
+
+    /**
+     * @brief Schema nodes carrying a "when" that can be instantiated as an implicit default.
+     *
+     * A full validation evaluates every "when" in the module, so it also drops a default node whose "when"
+     * has never held. Data stored by an application that creates defaults without validating them can contain
+     * such nodes, so they are revalidated regardless of what the edit touched.
+     */
+    struct ly_set dflt_when;
+
+    uint32_t class_count[LYD_VAL_DEP_CLASS_COUNT];
+};
+
+/**
+ * @brief Classify a single compiled XPath expression.
+ *
+ * @param[in] ctx_node Schema context node the expression is evaluated from, NULL for the data root.
+ * @param[in] cur_mod Module the expression was written in.
+ * @param[in] expr Parsed expression.
+ * @param[in] prefixes Compiled prefixes of the expression.
+ * @param[out] atoms Optional set of schema nodes the expression reads, caller frees with ::ly_set_free().
+ * @param[out] creation_safe Optional flag, see ::lyd_val_constraint.creation_safe.
+ * @param[out] unit Optional confining list, see ::lyd_val_constraint.unit.
+ * @return Dependency class, ::LYD_VAL_DEP_UNBOUNDED whenever the expression cannot be analysed.
+ */
+enum lyd_val_dep_class lyd_val_dep_classify_expr(const struct lysc_node *ctx_node, const struct lys_module *cur_mod,
+        const struct lyxp_expr *expr, const struct lysc_prefix *prefixes, struct ly_set **atoms,
+        ly_bool *creation_safe, const struct lysc_node **unit);
+
+/**
+ * @brief Get (building it first if needed) the dependency index of a module.
+ *
+ * @param[in] mod Module to index.
+ * @param[out] index Cached index, owned by the context.
+ * @return LY_ERR value.
+ */
+LY_ERR lyd_val_deps_get(const struct lys_module *mod, const struct lyd_val_dep_index **index);
+
+/**
+ * @brief Free all cached dependency indexes of a context.
+ *
+ * @param[in] ctx Context being destroyed.
+ */
+void lyd_val_deps_ctx_free(struct ly_ctx *ctx);
+
+/**
+ * @brief Name of a dependency class, for reports and logs.
+ *
+ * @param[in] cls Class to name.
+ * @return Static string.
+ */
+const char *lyd_val_dep_class_str(enum lyd_val_dep_class cls);
+
+/**
+ * @brief Name of a constraint kind, for reports and logs.
+ *
+ * @param[in] kind Kind to name.
+ * @return Static string.
+ */
+const char *lyd_val_dep_kind_str(enum lyd_val_dep_kind kind);
+
+#endif /* LY_VALIDATION_DEPS_H_ */
diff --git a/src/validation_incr.c b/src/validation_incr.c
new file mode 100644
index 0000000..cff70ca
--- /dev/null
+++ b/src/validation_incr.c
@@ -0,0 +1,802 @@
+/**
+ * @file validation_incr.c
+ * @brief Incremental validation driven by an edit diff.
+ *
+ * Copyright (c) 2026 Vecima Networks Inc.
+ *
+ * This source code is licensed under BSD 3-Clause License (the "License").
+ * You may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     https://opensource.org/licenses/BSD-3-Clause
+ */
+
+#define _GNU_SOURCE
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "diff.h"
+#include "ly_common.h"
+#include "parser_data.h"
+#include "plugins_exts/metadata.h"
+#include "plugins_types.h"
+#include "set.h"
+#include "tree_data.h"
+#include "tree_data_internal.h"
+#include "tree_schema.h"
+#include "validation.h"
+#include "validation_deps.h"
+
+/**
+ * @brief Everything the edit diff tells us about what may need revalidating.
+ */
+struct lyd_val_incr {
+    struct ly_set roots;        /**< data subtrees to validate in full */
+    struct ly_set path;         /**< ::lyd_val_incr.roots and all their data ancestors */
+    struct ly_set extra;        /**< individual nodes outside the scope whose cross-instance constraints
+                                     the edit could have changed */
+    struct ly_set created;      /**< schema nodes the edit only created */
+    struct ly_set modified;     /**< schema nodes the edit deleted or whose value it replaced */
+    ly_bool fallback;           /**< the edit could not be analysed, validate the whole module */
+};
+
+static void
+lyd_val_incr_erase(struct lyd_val_incr *incr)
+{
+    ly_set_erase(&incr->roots, NULL);
+    ly_set_erase(&incr->path, NULL);
+    ly_set_erase(&incr->extra, NULL);
+    ly_set_erase(&incr->created, NULL);
+    ly_set_erase(&incr->modified, NULL);
+}
+
+/**
+ * @brief Read the operation of a diff node, if it carries one of its own.
+ */
+static ly_bool
+lyd_val_incr_diff_op(const struct lyd_node *diff_node, enum lyd_diff_op *op)
+{
+    const struct lyd_meta *meta;
+    const struct lyd_attr *attr;
+    const char *str = NULL;
+
+    if (diff_node->schema) {
+        LY_LIST_FOR(diff_node->meta, meta) {
+            if (!strcmp(meta->name, "operation") && !strcmp(meta->annotation->module->name, "yang")) {
+                str = lyd_get_meta_value(meta);
+                break;
+            }
+        }
+    } else {
+        LY_LIST_FOR(((const struct lyd_node_opaq *)diff_node)->attr, attr) {
+            if (!strcmp(attr->name.name, "operation")) {
+                str = attr->value;
+                break;
+            }
+        }
+    }
+    if (!str) {
+        return 0;
+    }
+
+    switch (str[0]) {
+    case 'c':
+        *op = LYD_DIFF_OP_CREATE;
+        return 1;
+    case 'd':
+        *op = LYD_DIFF_OP_DELETE;
+        return 1;
+    case 'r':
+        *op = LYD_DIFF_OP_REPLACE;
+        return 1;
+    case 'n':
+        *op = LYD_DIFF_OP_NONE;
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+/**
+ * @brief Add a schema node and everything below it to a set of touched schema nodes.
+ */
+static LY_ERR
+lyd_val_incr_touch(struct ly_set *set, const struct lysc_node *snode)
+{
+    const struct lysc_node *elem;
+
+    LYSC_TREE_DFS_BEGIN(snode, elem) {
+        LY_CHECK_RET(ly_set_add(set, (void *)elem, 0, NULL));
+        LYSC_TREE_DFS_END(snode, elem);
+    }
+    return LY_SUCCESS;
+}
+
+/**
+ * @brief Find the data node a diff node refers to, or its closest existing ancestor.
+ *
+ * Walks down the tree using the diff node's own ancestor chain, which keeps the lookup on libyang's hashed
+ * sibling search instead of an XPath evaluation per diff node.
+ *
+ * @param[in] tree First top-level data node.
+ * @param[in] diff_node Diff node to locate.
+ * @param[out] match Node found, NULL if not even the first level matched.
+ * @return Whether @p match is the node itself rather than an ancestor.
+ */
+static ly_bool
+lyd_val_incr_find(const struct lyd_node *tree, const struct lyd_node *diff_node, struct lyd_node **match)
+{
+    const struct lyd_node *chain[64], *dnode;
+    struct lyd_node *cur = NULL, *found;
+    const struct lyd_node *siblings;
+    uint32_t depth = 0, i;
+
+    *match = NULL;
+
+    for (dnode = diff_node; dnode; dnode = lyd_parent(dnode)) {
+        if (depth == (sizeof chain / sizeof *chain)) {
+            return 0;
+        }
+        chain[depth++] = dnode;
+    }
+
+    siblings = tree;
+    for (i = depth; i > 0; --i) {
+        if (!chain[i - 1]->schema) {
+            /* opaque diff node, cannot be matched reliably */
+            return 0;
+        }
+        if (lyd_find_sibling_first(siblings, chain[i - 1], &found) || !found) {
+            *match = cur;
+            return 0;
+        }
+        cur = found;
+        siblings = lyd_child(cur);
+    }
+
+    *match = cur;
+    return 1;
+}
+
+/**
+ * @brief The subtree that has to be revalidated because something inside it changed.
+ *
+ * Normally the shallowest enclosing list instance: every confined constraint that can read @p node lives
+ * inside the list that confines it, and that list is at or below this one. A node read by a constraint that
+ * no list confines widens this to the whole top-level instance.
+ */
+static struct lyd_node *
+lyd_val_incr_root_of(struct lyd_node *node, ly_bool toplevel)
+{
+    struct lyd_node *root = NULL, *iter;
+
+    for (iter = node; iter; iter = lyd_parent(iter)) {
+        if (!toplevel && iter->schema && (iter->schema->nodetype & (LYS_LIST | LYS_LEAFLIST))) {
+            root = iter;
+        } else if (!lyd_parent(iter) && !root) {
+            root = iter;
+        }
+    }
+    return root;
+}
+
+static LY_ERR
+lyd_val_incr_add_root(struct lyd_val_incr *incr, struct lyd_node *root)
+{
+    struct lyd_node *iter;
+
+    if (ly_set_contains(&incr->roots, root, NULL)) {
+        return LY_SUCCESS;
+    }
+    LY_CHECK_RET(ly_set_add(&incr->roots, root, 1, NULL));
+
+    for (iter = root; iter; iter = lyd_parent(iter)) {
+        LY_CHECK_RET(ly_set_add(&incr->path, iter, 0, NULL));
+    }
+    return LY_SUCCESS;
+}
+
+/**
+ * @brief Turn an edit diff into the set of subtrees to revalidate and the schema nodes it touched.
+ */
+static LY_ERR
+lyd_val_incr_collect(const struct lyd_node *tree, const struct lys_module *mod, const struct lyd_val_dep_index *index,
+        const struct lyd_node *edit_diff, struct lyd_val_incr *incr)
+{
+    const struct lyd_node *dtop, *diter;
+    struct lyd_node *data, *root;
+    enum lyd_diff_op op;
+    ly_bool exact, toplevel;
+
+    LY_LIST_FOR(edit_diff, dtop) {
+        LYD_TREE_DFS_BEGIN(dtop, diter) {
+            if (!lyd_val_incr_diff_op(diter, &op) || (op == LYD_DIFF_OP_NONE)) {
+                goto next;
+            }
+            if (!diter->schema) {
+                /* an opaque change cannot be classified */
+                incr->fallback = 1;
+                return LY_SUCCESS;
+            }
+            if ((diter->flags & LYD_EXT) || (LYD_CTX(diter) != mod->ctx)) {
+                /* mounted data is validated by the extension plugin, out of reach of the dependency index */
+                incr->fallback = 1;
+                return LY_SUCCESS;
+            }
+
+            /* remember what the edit touched, for every module: a constraint of the validated module may well
+             * read another module's data */
+            LY_CHECK_RET(lyd_val_incr_touch((op == LYD_DIFF_OP_CREATE) ? &incr->created : &incr->modified,
+                    diter->schema));
+
+            if (lyd_owner_module(diter) != mod) {
+                /* only this module's data is being validated */
+                goto next;
+            }
+
+            exact = lyd_val_incr_find(tree, diter, &data);
+            if (!data) {
+                if (op == LYD_DIFF_OP_DELETE) {
+                    /* the whole top-level instance is gone, nothing left to revalidate */
+                    goto next;
+                }
+                /* a created or replaced node that is not in the tree means the diff does not describe it */
+                incr->fallback = 1;
+                return LY_SUCCESS;
+            }
+            if (!exact && (op != LYD_DIFF_OP_DELETE)) {
+                incr->fallback = 1;
+                return LY_SUCCESS;
+            }
+
+            toplevel = ly_set_contains(&index->toplevel_atoms, (void *)diter->schema, NULL);
+            root = lyd_val_incr_root_of(data, toplevel);
+            if (root) {
+                LY_CHECK_RET(lyd_val_incr_add_root(incr, root));
+            }
+
+next:
+            LYD_TREE_DFS_END(dtop, diter);
+        }
+    }
+
+    return LY_SUCCESS;
+}
+
+/**
+ * @brief Drop roots that already sit inside another root.
+ */
+static void
+lyd_val_incr_prune_roots(struct lyd_val_incr *incr)
+{
+    const struct lyd_node *iter;
+    uint32_t i = incr->roots.count;
+
+    while (i) {
+        --i;
+        for (iter = lyd_parent(incr->roots.dnodes[i]); iter; iter = lyd_parent(iter)) {
+            if (ly_set_contains(&incr->roots, (void *)iter, NULL)) {
+                ly_set_rm_index(&incr->roots, i, NULL);
+                break;
+            }
+        }
+    }
+}
+
+/**
+ * @brief Whether any atom of a constraint is among the schema nodes an edit touched.
+ */
+static ly_bool
+lyd_val_incr_atoms_hit(const struct lyd_val_constraint *cons, const struct ly_set *touched)
+{
+    uint32_t i;
+
+    if (!touched->count) {
+        return 0;
+    }
+    for (i = 0; cons->atoms && cons->atoms[i]; ++i) {
+        if (ly_set_contains(touched, (void *)cons->atoms[i], NULL)) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/**
+ * @brief Collect the schema nodes whose cross-instance constraints the edit could have changed.
+ */
+static LY_ERR
+lyd_val_incr_wanted(const struct lyd_val_dep_index *index, const struct lyd_val_incr *incr, struct ly_set *wanted)
+{
+    const struct lyd_val_constraint *cons;
+    uint32_t i;
+
+    for (i = 0; i < index->nonlocal_count; ++i) {
+        cons = &index->constraints[index->nonlocal[i]];
+
+        if (!lyd_val_incr_atoms_hit(cons, &incr->modified) &&
+                (cons->creation_safe || !lyd_val_incr_atoms_hit(cons, &incr->created))) {
+            continue;
+        }
+        LY_CHECK_RET(ly_set_add(wanted, (void *)cons->snode, 0, NULL));
+    }
+
+    for (i = 0; i < index->dflt_when.count; ++i) {
+        LY_CHECK_RET(ly_set_add(wanted, index->dflt_when.snodes[i], 0, NULL));
+    }
+    return LY_SUCCESS;
+}
+
+/**
+ * @brief Collect @p wanted and every schema node between them and the data root.
+ *
+ * Lets the search for their instances skip whole subtrees that cannot contain one.
+ */
+static LY_ERR
+lyd_val_incr_wanted_path(const struct ly_set *wanted, struct ly_set *path)
+{
+    const struct lysc_node *snode;
+    uint32_t i;
+
+    for (i = 0; i < wanted->count; ++i) {
+        for (snode = wanted->snodes[i]; snode; snode = lysc_data_parent(snode)) {
+            LY_CHECK_RET(ly_set_add(path, (void *)snode, 0, NULL));
+        }
+    }
+    return LY_SUCCESS;
+}
+
+/**
+ * @brief Find the instances of @p wanted schema nodes that the scoped passes would otherwise skip.
+ */
+static LY_ERR
+lyd_val_incr_extra(const struct lyd_node *tree, const struct lys_module *mod, const struct ly_set *wanted,
+        const struct ly_set *wanted_path, struct lyd_val_incr *incr)
+{
+    const struct lyd_node *first, *sibling, *elem;
+
+    first = tree;
+    lyd_first_module_sibling((struct lyd_node **)&first, mod);
+
+    LY_LIST_FOR(first, sibling) {
+        if (lyd_owner_module(sibling) != mod) {
+            break;
+        }
+        LYD_TREE_DFS_BEGIN(sibling, elem) {
+            if (!elem->schema || !ly_set_contains(wanted_path, (void *)elem->schema, NULL)) {
+                /* nothing wanted can be in here */
+                LYD_TREE_DFS_continue = 1;
+            } else if (ly_set_contains(wanted, (void *)elem->schema, NULL) &&
+                    !ly_set_contains(&incr->roots, (void *)elem, NULL)) {
+                LY_CHECK_RET(ly_set_add(&incr->extra, (void *)elem, 0, NULL));
+            }
+            LYD_TREE_DFS_END(sibling, elem);
+        }
+    }
+
+    return LY_SUCCESS;
+}
+
+/**
+ * @brief Drop extra nodes that already sit inside a subtree scheduled for a full revalidation.
+ */
+static void
+lyd_val_incr_prune_extra(struct lyd_val_incr *incr)
+{
+    const struct lyd_node *iter;
+    uint32_t i = incr->extra.count;
+
+    while (i) {
+        --i;
+        for (iter = incr->extra.dnodes[i]; iter; iter = lyd_parent(iter)) {
+            if (ly_set_contains(&incr->roots, (void *)iter, NULL)) {
+                ly_set_rm_index(&incr->extra, i, NULL);
+                break;
+            }
+        }
+    }
+}
+
+/**
+ * @brief Work out what a change described by @p edit_diff makes necessary in @p mod.
+ *
+ * Only reads @p tree, so it may be repeated once the earlier validation passes have settled the tree.
+ */
+static LY_ERR
+lyd_val_incr_analyze(const struct lyd_node *tree, const struct lys_module *mod, const struct lyd_node *edit_diff,
+        struct lyd_val_incr *incr)
+{
+    const struct lyd_val_dep_index *index;
+    LY_ERR rc;
+
+    ly_set_erase(&incr->roots, NULL);
+    ly_set_erase(&incr->path, NULL);
+
+    rc = lyd_val_deps_get(mod, &index);
+    if (rc) {
+        incr->fallback = 1;
+        return LY_SUCCESS;
+    }
+
+    rc = lyd_val_incr_collect(tree, mod, index, edit_diff, incr);
+    LY_CHECK_RET(rc);
+    if (incr->fallback) {
+        return LY_SUCCESS;
+    }
+    lyd_val_incr_prune_roots(incr);
+
+    return LY_SUCCESS;
+}
+
+/**
+ * @brief Find the nodes outside the scope roots that the change can still have invalidated.
+ *
+ * Has to run once the tree is settled: implicit defaults created by the earlier passes are exactly the kind of
+ * node this looks for.
+ */
+static LY_ERR
+lyd_val_incr_analyze_extra(const struct lyd_node *tree, const struct lys_module *mod, struct lyd_val_incr *incr)
+{
+    const struct lyd_val_dep_index *index;
+    struct ly_set wanted = {0}, wanted_path = {0};
+    LY_ERR rc;
+
+    ly_set_erase(&incr->extra, NULL);
+
+    rc = lyd_val_deps_get(mod, &index);
+    if (rc) {
+        incr->fallback = 1;
+        return LY_SUCCESS;
+    }
+
+    rc = lyd_val_incr_wanted(index, incr, &wanted);
+    LY_CHECK_GOTO(rc, cleanup);
+
+    if (wanted.count) {
+        rc = lyd_val_incr_wanted_path(&wanted, &wanted_path);
+        LY_CHECK_GOTO(rc, cleanup);
+
+        rc = lyd_val_incr_extra(tree, mod, &wanted, &wanted_path, incr);
+        LY_CHECK_GOTO(rc, cleanup);
+        lyd_val_incr_prune_extra(incr);
+    }
+
+cleanup:
+    ly_set_erase(&wanted, NULL);
+    ly_set_erase(&wanted_path, NULL);
+    return rc;
+}
+
+/* a context is dropped and recreated on every schema change, so the totals of a whole run need to outlive it */
+static pthread_mutex_t lyd_val_incr_glob_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct lyd_validate_incr_stats lyd_val_incr_glob;
+
+static void
+lyd_val_incr_count(const struct ly_ctx *ctx, const struct lyd_val_incr *incr, ly_bool fallback)
+{
+    struct ly_ctx *c = (struct ly_ctx *)ctx;
+
+    pthread_mutex_lock(&c->val_deps_lock);
+    ++c->val_incr_stats.calls;
+    if (fallback) {
+        ++c->val_incr_stats.fallbacks;
+    } else {
+        c->val_incr_stats.scope_roots += incr->roots.count;
+        c->val_incr_stats.extra_nodes += incr->extra.count;
+    }
+    pthread_mutex_unlock(&c->val_deps_lock);
+
+    pthread_mutex_lock(&lyd_val_incr_glob_lock);
+    ++lyd_val_incr_glob.calls;
+    if (fallback) {
+        ++lyd_val_incr_glob.fallbacks;
+    } else {
+        lyd_val_incr_glob.scope_roots += incr->roots.count;
+        lyd_val_incr_glob.extra_nodes += incr->extra.count;
+    }
+    pthread_mutex_unlock(&lyd_val_incr_glob_lock);
+}
+
+LIBYANG_API_DEF void
+lyd_validate_incr_stats(const struct ly_ctx *ctx, uint64_t *calls, uint64_t *fallbacks)
+{
+    struct ly_ctx *c = (struct ly_ctx *)ctx;
+    pthread_mutex_t *lock = ctx ? &c->val_deps_lock : &lyd_val_incr_glob_lock;
+    const struct lyd_validate_incr_stats *stats = ctx ? &c->val_incr_stats : &lyd_val_incr_glob;
+
+    pthread_mutex_lock(lock);
+    if (calls) {
+        *calls = stats->calls;
+    }
+    if (fallbacks) {
+        *fallbacks = stats->fallbacks;
+    }
+    pthread_mutex_unlock(lock);
+}
+
+/**
+ * @brief Re-register the unresolved parts of a node that the scoped subtree walk did not visit.
+ */
+static LY_ERR
+lyd_val_incr_unres_extra(const struct lyd_val_incr *incr, struct ly_set *node_when, struct ly_set *node_types)
+{
+    struct lyd_node *node;
+    uint32_t i;
+
+    for (i = 0; i < incr->extra.count; ++i) {
+        node = incr->extra.dnodes[i];
+
+        /* the earlier passes may have queued the same node already and a duplicate would be used after the
+         * autodeletion frees it */
+        if (lysc_has_when(node->schema)) {
+            LY_CHECK_RET(ly_set_add(node_when, node, 0, NULL));
+        }
+        if ((node->schema->nodetype & LYD_NODE_TERM) &&
+                ((struct lysc_node_leaf *)node->schema)->type->plugin->validate) {
+            LY_CHECK_RET(ly_set_add(node_types, node, 0, NULL));
+        }
+    }
+    return LY_SUCCESS;
+}
+
+/**
+ * @brief Run the sibling-level checks on the way down to the scope roots.
+ *
+ * Full validation reaches these through the subtree walk of every top-level node; the scoped walk starts at the
+ * roots, so duplicate instance detection and default autodeletion above them have to be driven explicitly.
+ *
+ * Descends along the live tree rather than the collected node pointers, because the checks autodelete.
+ */
+static LY_ERR
+lyd_val_incr_new_above(struct lyd_node *node, const struct lyd_val_incr *incr, uint32_t val_opts,
+        struct ly_ht *getnext_ht, struct lyd_node **diff)
+{
+    LY_ERR r, rc = LY_SUCCESS;
+    struct lyd_node *child;
+
+    if (!(node->schema->nodetype & LYD_NODE_INNER)) {
+        return LY_SUCCESS;
+    }
+
+    r = lyd_validate_new(lyd_node_child_p(node), node->schema, NULL, NULL, val_opts, 0, getnext_ht, diff);
+    LY_VAL_ERR_GOTO(r, rc = r, val_opts, cleanup);
+
+    LY_LIST_FOR(lyd_child(node), child) {
+        /* the roots get this from their own subtree walk */
+        if (ly_set_contains(&incr->path, child, NULL) && !ly_set_contains(&incr->roots, child, NULL)) {
+            r = lyd_val_incr_new_above(child, incr, val_opts, getnext_ht, diff);
+            LY_VAL_ERR_GOTO(r, rc = r, val_opts, cleanup);
+        }
+    }
+
+cleanup:
+    return rc;
+}
+
+/**
+ * @brief Create the implicit nodes of @p mod, top level included.
+ *
+ * The full pass gets the nested ones from the subtree walk of every top-level node, which the scoped walk skips.
+ * lyd_new_implicit_r() cannot be used on the top level directly, it would run past the module data into the
+ * following siblings.
+ */
+static LY_ERR
+lyd_val_incr_implicit(struct lyd_node **first2, const struct lys_module *mod, uint32_t impl_opts,
+        struct ly_ht *getnext_ht, struct lyd_node **diff)
+{
+    struct lyd_node *child;
+
+    LY_CHECK_RET(lyd_new_implicit(NULL, first2, NULL, mod, NULL, NULL, NULL, impl_opts, getnext_ht, diff));
+
+    LY_LIST_FOR(*first2, child) {
+        if (lyd_owner_module(child) != mod) {
+            break;
+        }
+        if ((child->flags & LYD_DEFAULT) && (child->schema->nodetype == LYS_CONTAINER)) {
+            LY_CHECK_RET(lyd_new_implicit_r(child, lyd_node_child_p(child), NULL, NULL, NULL, NULL, NULL, impl_opts,
+                    getnext_ht, diff));
+        }
+    }
+
+    return LY_SUCCESS;
+}
+
+/**
+ * @brief Rebuild the scope against the current tree, giving up on the incremental path if it no longer holds.
+ *
+ * Every pass that inserts or autodeletes nodes invalidates the collected node pointers.
+ */
+#define LYD_VAL_INCR_REANALYZE \
+    first = *first2; \
+    lyd_first_module_sibling(&first, module); \
+    first2 = (!first || (first == *tree)) ? tree : &first; \
+    r = lyd_val_incr_analyze(*tree, module, edit_diff, &incr); \
+    LY_CHECK_ERR_GOTO(r, rc = r, cleanup); \
+    if (incr.fallback) { \
+        lyd_val_incr_count(module->ctx, &incr, 1); \
+        rc = lyd_validate_module(tree, module, val_opts, diff); \
+        goto cleanup; \
+    }
+
+LIBYANG_API_DEF LY_ERR
+lyd_validate_module_incr(struct lyd_node **tree, const struct lys_module *module, const struct lyd_node *edit_diff,
+        uint32_t val_opts, struct lyd_node **diff)
+{
+    LY_ERR r, rc = LY_SUCCESS;
+    struct lyd_val_incr incr = {0};
+    struct lyd_val_scope scope;
+    struct ly_set node_types = {0}, meta_types = {0}, node_when = {0}, ext_node = {0}, ext_val = {0};
+    struct ly_ht *getnext_ht = NULL;
+    struct lyd_node *first, **first2, *iter;
+    uint32_t i, impl_opts;
+
+    LY_CHECK_ARG_RET(NULL, tree, module, !(val_opts & LYD_VALIDATE_PRESENT), LY_EINVAL);
+    LY_CHECK_CTX_EQUAL_RET(__func__, *tree ? LYD_CTX(*tree) : NULL, module->ctx, LY_EINVAL);
+
+    if (diff) {
+        *diff = NULL;
+    }
+    if (!edit_diff || !*tree) {
+        lyd_val_incr_count(module->ctx, &incr, 1);
+        return lyd_validate_module(tree, module, val_opts, diff);
+    }
+
+    rc = lyd_val_incr_analyze(*tree, module, edit_diff, &incr);
+    LY_CHECK_GOTO(rc, cleanup);
+
+    if (incr.fallback) {
+        lyd_val_incr_count(module->ctx, &incr, 1);
+        rc = lyd_validate_module(tree, module, val_opts, diff);
+        goto cleanup;
+    }
+
+    r = lyd_val_getnext_ht_new(&getnext_ht);
+    LY_CHECK_ERR_GOTO(r, rc = r, cleanup);
+
+    first = *tree;
+    lyd_first_module_sibling(&first, module);
+    first2 = (!first || (first == *tree)) ? tree : &first;
+
+    /* the top level is walked in full: it is a single sibling list and everything on it is cheap to check */
+    r = lyd_validate_new(first2, *first2 ? lysc_data_parent((*first2)->schema) : NULL, module, NULL, val_opts, 0,
+            getnext_ht, diff);
+    LY_VAL_ERR_GOTO(r, rc = r, val_opts, cleanup);
+
+    /* autodeletion above may have freed nodes the scope points at, so resolve the diff against the tree again */
+    LYD_VAL_INCR_REANALYZE;
+
+    LY_LIST_FOR(*first2, iter) {
+        if (lyd_owner_module(iter) != module) {
+            break;
+        }
+        if (ly_set_contains(&incr.path, iter, NULL) && !ly_set_contains(&incr.roots, iter, NULL)) {
+            r = lyd_val_incr_new_above(iter, &incr, val_opts, getnext_ht, diff);
+            LY_VAL_ERR_GOTO(r, rc = r, val_opts, cleanup);
+        }
+    }
+
+    impl_opts = 0;
+    if (val_opts & LYD_VALIDATE_NO_STATE) {
+        impl_opts |= LYD_IMPLICIT_NO_STATE;
+    }
+    if (val_opts & LYD_VALIDATE_NO_DEFAULTS) {
+        impl_opts |= LYD_IMPLICIT_NO_DEFAULTS;
+    }
+    r = lyd_val_incr_implicit(first2, module, impl_opts, getnext_ht, diff);
+    LY_CHECK_ERR_GOTO(r, rc = r, cleanup);
+
+    /* both passes above rearranged the tree, this is the last chance to build the scope */
+    LYD_VAL_INCR_REANALYZE;
+
+    /* implicit top-level defaults are new data of this module and need the same treatment as the edit */
+    LY_LIST_FOR(*first2, iter) {
+        if (lyd_owner_module(iter) != module) {
+            break;
+        }
+        if ((iter->flags & LYD_NEW) && !ly_set_contains(&incr.roots, iter, NULL)) {
+            r = lyd_val_incr_add_root(&incr, iter);
+            LY_CHECK_ERR_GOTO(r, rc = r, cleanup);
+        }
+    }
+
+    lyd_val_incr_count(module->ctx, &incr, 0);
+
+    for (i = 0; i < incr.roots.count; ++i) {
+        r = lyd_validate_subtree(incr.roots.dnodes[i], &node_when, &node_types, &meta_types, &ext_node, &ext_val,
+                val_opts, 0, getnext_ht, diff);
+        LY_VAL_ERR_GOTO(r, rc = r, val_opts, cleanup);
+    }
+
+    /* the tree stops changing shape here, so the out-of-scope nodes to recheck can finally be looked up */
+    r = lyd_val_incr_analyze_extra(*tree, module, &incr);
+    LY_CHECK_ERR_GOTO(r, rc = r, cleanup);
+
+    r = lyd_val_incr_unres_extra(&incr, &node_when, &node_types);
+    LY_CHECK_ERR_GOTO(r, rc = r, cleanup);
+
+    r = lyd_validate_unres(first2, module, LYD_TYPE_DATA_YANG, &node_when, 0, &node_types, &meta_types, &ext_node,
+            &ext_val, val_opts, diff);
+    LY_VAL_ERR_GOTO(r, rc = r, val_opts, cleanup);
+
+    if (!(val_opts & LYD_VALIDATE_NOT_FINAL)) {
+        /* "when" resolution above autodeletes, the extra nodes have to be looked up once more */
+        r = lyd_val_incr_analyze_extra(*tree, module, &incr);
+        LY_CHECK_ERR_GOTO(r, rc = r, cleanup);
+
+        scope.roots = &incr.roots;
+        scope.path = &incr.path;
+        r = lyd_validate_final_r(*first2, NULL, NULL, module, NULL, val_opts, 0, 0, getnext_ht, &scope);
+        LY_VAL_ERR_GOTO(r, rc = r, val_opts, cleanup);
+
+        for (i = 0; i < incr.extra.count; ++i) {
+            r = lyd_validate_must(incr.extra.dnodes[i], val_opts, 0, 0);
+            LY_VAL_ERR_GOTO(r, rc = r, val_opts, cleanup);
+        }
+    }
+
+cleanup:
+    ly_set_erase(&node_when, NULL);
+    ly_set_erase(&node_types, NULL);
+    ly_set_erase(&meta_types, NULL);
+    ly_set_erase(&ext_node, free);
+    ly_set_erase(&ext_val, free);
+    lyd_val_getnext_ht_free(getnext_ht);
+    lyd_val_incr_erase(&incr);
+    return rc;
+}
+
+LIBYANG_API_DEF LY_ERR
+lyd_validate_module_incr_final(struct lyd_node *tree, const struct lys_module *module,
+        const struct lyd_node *edit_diff, uint32_t val_opts)
+{
+    LY_ERR r, rc = LY_SUCCESS;
+    struct lyd_val_incr incr = {0};
+    struct lyd_val_scope scope;
+    struct ly_ht *getnext_ht = NULL;
+    struct lyd_node *first;
+    const struct lys_module *mod;
+    uint32_t i, idx = 0;
+
+    LY_CHECK_ARG_RET(NULL, module, !(val_opts & (LYD_VALIDATE_PRESENT | LYD_VALIDATE_NOT_FINAL)), LY_EINVAL);
+    LY_CHECK_CTX_EQUAL_RET(__func__, tree ? LYD_CTX(tree) : NULL, module->ctx, LY_EINVAL);
+
+    if (!edit_diff || !tree) {
+        return lyd_validate_module_final(tree, module, val_opts);
+    }
+
+    rc = lyd_val_incr_analyze(tree, module, edit_diff, &incr);
+    LY_CHECK_GOTO(rc, cleanup);
+
+    if (!incr.fallback) {
+        rc = lyd_val_incr_analyze_extra(tree, module, &incr);
+        LY_CHECK_GOTO(rc, cleanup);
+    }
+    if (incr.fallback) {
+        rc = lyd_validate_module_final(tree, module, val_opts);
+        goto cleanup;
+    }
+
+    mod = lyd_mod_next_module(tree, module, module->ctx, &idx, &first);
+    assert(mod);
+
+    r = lyd_val_getnext_ht_new(&getnext_ht);
+    LY_CHECK_ERR_GOTO(r, rc = r, cleanup);
+
+    scope.roots = &incr.roots;
+    scope.path = &incr.path;
+    r = lyd_validate_final_r(first, NULL, NULL, mod, NULL, val_opts, 0, 0, getnext_ht, &scope);
+    LY_VAL_ERR_GOTO(r, rc = r, val_opts, cleanup);
+
+    for (i = 0; i < incr.extra.count; ++i) {
+        r = lyd_validate_must(incr.extra.dnodes[i], val_opts, 0, 0);
+        LY_VAL_ERR_GOTO(r, rc = r, val_opts, cleanup);
+    }
+
+cleanup:
+    lyd_val_getnext_ht_free(getnext_ht);
+    lyd_val_incr_erase(&incr);
+    return rc;
+}
