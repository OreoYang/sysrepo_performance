diff --git a/src/validation.h b/src/validation.h
index 01de310..124d1d7 100644
--- a/src/validation.h
+++ b/src/validation.h
@@ -24,9 +24,60 @@
 struct ly_ctx;
 struct ly_set;
 struct lyd_node;
+struct lyd_val_incr;
 struct lys_module;
+struct lysc_must;
 struct lysc_node;
 
+/**
+ * @brief Check validation error taking into account multi-error validation.
+ *
+ * @param[in] r Local return value.
+ * @param[in] err_cmd Command to perform on any error.
+ * @param[in] val_opts Validation options.
+ * @param[in] label Label to go to on fatal error.
+ */
+#define LY_VAL_ERR_GOTO(r, err_cmd, val_opts, label) \
+        if (r) { \
+            err_cmd; \
+            if ((r != LY_EVALID) || !(val_opts & LYD_VALIDATE_MULTI_ERROR)) { \
+                goto label; \
+            } \
+        }
+
+/**
+ * @brief Part of a data tree the final validation pass is restricted to.
+ *
+ * Only list and leaf-list instances are ever skipped. Everything else is visited, so a constraint whose
+ * dependencies are not confined to a single list instance is always re-evaluated.
+ */
+struct lyd_val_scope {
+    const struct ly_set *roots;     /**< subtrees to validate in full */
+    const struct ly_set *path;      /**< ::lyd_val_scope.roots and all their data ancestors */
+    const struct lyd_val_incr *incr;    /**< edit being validated, used to skip value-keyed "must" conditions
+                                             the edit cannot have violated, NULL to evaluate all of them */
+};
+
+/**
+ * @brief Whether an edit cannot have violated a value-keyed "must" on a specific node.
+ *
+ * @param[in] incr Edit being validated.
+ * @param[in] node Node the condition is attached to.
+ * @param[in] must Condition to evaluate or skip.
+ * @return Whether the condition can be left unevaluated, 0 whenever that cannot be proven.
+ */
+ly_bool lyd_val_incr_must_skip(const struct lyd_val_incr *incr, const struct lyd_node *node,
+        const struct lysc_must *must);
+
+/**
+ * @brief Add to the "must" counters of incremental validation.
+ *
+ * @param[in] ctx Context the conditions belong to.
+ * @param[in] evals Conditions evaluated.
+ * @param[in] skips Conditions left unevaluated by ::lyd_val_incr_must_skip().
+ */
+void lyd_val_incr_must_count(const struct ly_ctx *ctx, uint64_t evals, uint64_t skips);
+
 /**
  * @brief Cached getnext schema nodes stored in a validation HT.
  */
@@ -131,6 +182,77 @@ LY_ERR lyd_validate_new(struct lyd_node **first, const struct lysc_node *sparent
  */
 LY_ERR lyd_validate_node_ext(struct lyd_node *node, struct ly_set *ext_node);
 
+/**
+ * @brief Validate data siblings based on generic schema node restrictions, recursively for schema-only nodes.
+ *
+ * Covers mandatory nodes, min-elements, max-elements and unique.
+ *
+ * @param[in] first First sibling to search in.
+ * @param[in] parent Data parent.
+ * @param[in] sparent Schema parent of the nodes to check.
+ * @param[in] mod Module of the nodes to check.
+ * @param[in] ext Extension instance to use, if relevant.
+ * @param[in] val_opts Validation options, see @ref datavalidationoptions.
+ * @param[in] int_opts Internal parser options.
+ * @param[in,out] getnext_ht Getnext HT to use, new @p sparent is added to it.
+ * @return LY_ERR value.
+ */
+LY_ERR lyd_validate_siblings_schema_r(const struct lyd_node *first, const struct lyd_node *parent,
+        const struct lysc_node *sparent, const struct lys_module *mod, const struct lysc_ext_instance *ext,
+        uint32_t val_opts, uint32_t int_opts, struct ly_ht *getnext_ht);
+
+/**
+ * @brief Validate must conditions of a data node.
+ *
+ * @param[in] node Node to validate.
+ * @param[in] val_opts Validation options.
+ * @param[in] int_opts Internal parser options.
+ * @param[in] xpath_options Additional XPath options to use.
+ * @param[in] incr Optional edit being validated, lets ::lyd_val_incr_must_skip() leave conditions the edit
+ * cannot have violated unevaluated.
+ * @return LY_ERR value.
+ */
+LY_ERR lyd_validate_must(const struct lyd_node *node, uint32_t val_opts, uint32_t int_opts, uint32_t xpath_options,
+        const struct lyd_val_incr *incr);
+
+/**
+ * @brief Validate the whole data subtree.
