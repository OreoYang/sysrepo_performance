 src/validation_deps.c                    |   7 +-
 src/validation_deps.h                    |   8 +
 src/validation_incr.c                    |  93 ++-
 tests/utests/data/test_validation_incr.c | 897 ++++++++++++++++++++++-
 5 files changed, 991 insertions(+), 24 deletions(-)

