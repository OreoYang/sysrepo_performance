+        "            leaf mtu { type uint32; must \"../speed <= .\"; }\n"
+        "            leaf peer { type leafref { path \"/a:ifs/a:if/a:name\"; } }\n"
+        /* creating the m2 case makes the validation delete the default m1 case */
