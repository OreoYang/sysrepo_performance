From af470a99b4e01d8673eaf6b0c64cc5d833e2004e Mon Sep 17 00:00:00 2001
From: "Oreo.Yang" <2167young@163.com>
Date: Sat, 24 Oct 2026 15:06:54 +0800
Subject: [PATCH] validation BUGFIX arithmetic reads the first node of a
 node-set

+, -, *, div and mod turn a node-set into the number of its first node,
like number(), so a rule using them over an absolute path is not safe to
skip on creation.

Share one helper for the incremental validation counters, and give the
deep delete test its own loop variable.
---
 src/validation_deps.c                    | 10 ++++
 src/validation_incr.c                    | 71 ++++++++++++------------
 tests/utests/data/test_validation_incr.c | 14 +++--
 3 files changed, 55 insertions(+), 40 deletions(-)

diff --git a/src/validation_deps.c b/src/validation_deps.c
index 3d80509..b163271 100644
--- a/src/validation_deps.c
+++ b/src/validation_deps.c
@@ -306,6 +306,16 @@ lyd_val_dep_shape_scan(const struct lyxp_expr *expr, struct lyd_val_dep_shape *s
                 shape->antitone = 1;
             }
             break;
+        case LYXP_TOKEN_OPER_MATH: {
+            uint32_t from, to;
+
+            /* arithmetic turns a node-set into the number of its first node, like number() */
+            lyd_val_dep_operand_span(expr, i, &from, &to);
+            if (lyd_val_dep_span_has_abs(expr, from, to)) {
+                shape->antitone = 1;
+            }
+            break;
+        }
         case LYXP_TOKEN_OPER_NEQUAL: {
             uint32_t from, to;
 
diff --git a/src/validation_incr.c b/src/validation_incr.c
index 9dcc514..4994bff 100644
--- a/src/validation_incr.c
+++ b/src/validation_incr.c
@@ -689,30 +689,43 @@ cleanup:
 static pthread_mutex_t lyd_val_incr_glob_lock = PTHREAD_MUTEX_INITIALIZER;
 static struct lyd_validate_incr_stats lyd_val_incr_glob;
 
+/**
+ * @brief Add counters to the totals of the context and of the process.
+ */
 static void
-lyd_val_incr_count(const struct ly_ctx *ctx, const struct lyd_val_incr *incr, ly_bool fallback)
+lyd_val_incr_stats_add(const struct ly_ctx *ctx, const struct lyd_validate_incr_stats *delta)
 {
     struct ly_ctx *c = (struct ly_ctx *)ctx;
+    struct lyd_validate_incr_stats *dst[2] = {&c->val_incr_stats, &lyd_val_incr_glob};
+    pthread_mutex_t *lock[2] = {&c->val_deps_lock, &lyd_val_incr_glob_lock};
+    uint32_t i;
 
-    pthread_mutex_lock(&c->val_deps_lock);
-    ++c->val_incr_stats.calls;
-    if (fallback) {
-        ++c->val_incr_stats.fallbacks;
-    } else {
-        c->val_incr_stats.scope_roots += incr->roots.count;
-        c->val_incr_stats.extra_nodes += incr->extra.count;
+    for (i = 0; i < 2; ++i) {
+        pthread_mutex_lock(lock[i]);
+        dst[i]->calls += delta->calls;
+        dst[i]->fallbacks += delta->fallbacks;
+        dst[i]->scope_roots += delta->scope_roots;
+        dst[i]->extra_nodes += delta->extra_nodes;
+        dst[i]->must_evals += delta->must_evals;
+        dst[i]->must_skips += delta->must_skips;
+        dst[i]->late_fallbacks += delta->late_fallbacks;
+        pthread_mutex_unlock(lock[i]);
     }
-    pthread_mutex_unlock(&c->val_deps_lock);
+}
 
-    pthread_mutex_lock(&lyd_val_incr_glob_lock);
-    ++lyd_val_incr_glob.calls;
+static void
+lyd_val_incr_count(const struct ly_ctx *ctx, const struct lyd_val_incr *incr, ly_bool fallback)
+{
+    struct lyd_validate_incr_stats delta = {0};
+
+    delta.calls = 1;
     if (fallback) {
-        ++lyd_val_incr_glob.fallbacks;
+        delta.fallbacks = 1;
     } else {
-        lyd_val_incr_glob.scope_roots += incr->roots.count;
-        lyd_val_incr_glob.extra_nodes += incr->extra.count;
+        delta.scope_roots = incr->roots.count;
+        delta.extra_nodes = incr->extra.count;
     }
-    pthread_mutex_unlock(&lyd_val_incr_glob_lock);
+    lyd_val_incr_stats_add(ctx, &delta);
 }
 
 /**
@@ -721,17 +734,11 @@ lyd_val_incr_count(const struct ly_ctx *ctx, const struct lyd_val_incr *incr, ly
 static void
 lyd_val_incr_count_late_fallback(const struct ly_ctx *ctx)
 {
-    struct ly_ctx *c = (struct ly_ctx *)ctx;
+    struct lyd_validate_incr_stats delta = {0};
 
-    pthread_mutex_lock(&c->val_deps_lock);
-    ++c->val_incr_stats.fallbacks;
-    ++c->val_incr_stats.late_fallbacks;
-    pthread_mutex_unlock(&c->val_deps_lock);
-
-    pthread_mutex_lock(&lyd_val_incr_glob_lock);
-    ++lyd_val_incr_glob.fallbacks;
-    ++lyd_val_incr_glob.late_fallbacks;
-    pthread_mutex_unlock(&lyd_val_incr_glob_lock);
+    delta.fallbacks = 1;
+    delta.late_fallbacks = 1;
+    lyd_val_incr_stats_add(ctx, &delta);
 }
 
 LIBYANG_API_DEF void
@@ -751,21 +758,15 @@ lyd_validate_incr_late_stats(const struct ly_ctx *ctx, uint64_t *late_fallbacks)
 void
 lyd_val_incr_must_count(const struct ly_ctx *ctx, uint64_t evals, uint64_t skips)
 {
-    struct ly_ctx *c = (struct ly_ctx *)ctx;
+    struct lyd_validate_incr_stats delta = {0};
 
     if (!evals && !skips) {
         return;
     }
 
-    pthread_mutex_lock(&c->val_deps_lock);
-    c->val_incr_stats.must_evals += evals;
-    c->val_incr_stats.must_skips += skips;
-    pthread_mutex_unlock(&c->val_deps_lock);
-
-    pthread_mutex_lock(&lyd_val_incr_glob_lock);
-    lyd_val_incr_glob.must_evals += evals;
-    lyd_val_incr_glob.must_skips += skips;
-    pthread_mutex_unlock(&lyd_val_incr_glob_lock);
+    delta.must_evals = evals;
+    delta.must_skips = skips;
+    lyd_val_incr_stats_add(ctx, &delta);
 }
 
 LIBYANG_API_DEF void
diff --git a/tests/utests/data/test_validation_incr.c b/tests/utests/data/test_validation_incr.c
index f3ac1dc..19dfbd4 100644
--- a/tests/utests/data/test_validation_incr.c
+++ b/tests/utests/data/test_validation_incr.c
@@ -874,6 +874,10 @@ static const char *schema_c =
         "                type string;\n"
         "                must \"contains(/a:ifs/a:if[a:name = current()/../ifname]/b:b-addr/b:ip, '10.')\";\n"
         "            }\n"
+        "            leaf idmath {\n"
+        "                type string;\n"
+        "                must \"/a:ifs/a:if[a:name = current()/../ifname]/b:b-addr/b:id + 0 > 1\";\n"
+        "            }\n"
         "            leaf ipany {\n"
         "                type string;\n"
         "                must \"/a:ifs/a:if[a:name = current()/../ifname]/b:b-addr/b:ip = '10.0.0.1'\";\n"
@@ -1286,7 +1290,7 @@ test_aug_first_node_func(void **state)
     assert_int_equal(LY_SUCCESS, lyd_val_deps_get(mod, &index));
     for (i = 0; i < index->constraint_count; ++i) {
         cons = &index->constraints[i];
-        if (!strcmp(cons->snode->name, "ipfirst")) {
+        if (!strcmp(cons->snode->name, "ipfirst") || !strcmp(cons->snode->name, "idmath")) {
             assert_false(cons->creation_safe);
             ++seen;
         } else if (!strcmp(cons->snode->name, "ipany")) {
@@ -1294,7 +1298,7 @@ test_aug_first_node_func(void **state)
             ++seen;
         }
     }
-    assert_int_equal(2, seen);
+    assert_int_equal(3, seen);
 
     aug_done();
 }
@@ -1314,7 +1318,7 @@ test_aug_deep_delete(void **state)
     const char *edit[] = {del, NULL, NULL, NULL};
     uint64_t fb_before = 0, fb_after = 0;
     LY_ERR rc;
-    int i;
+    int i, entry;
 
     /* only list instances can be left out of a scoped pass, so the deep node sits below one */
     strcat(schema, "list l {\nkey k;\nleaf k { type string; }\n");
@@ -1337,8 +1341,8 @@ test_aug_deep_delete(void **state)
         snprintf(tmp, sizeof tmp, "/c%d", i);
         strcat(path, tmp);
     }
-    for (rc = 0; rc < 2; ++rc) {
-        strcat(xml, rc ? "<l xmlns=\"urn:tests:deep\"><k>2</k>" : "<l xmlns=\"urn:tests:deep\"><k>1</k>");
+    for (entry = 0; entry < 2; ++entry) {
+        strcat(xml, entry ? "<l xmlns=\"urn:tests:deep\"><k>2</k>" : "<l xmlns=\"urn:tests:deep\"><k>1</k>");
         for (i = 1; i < DEEP_LEVELS; ++i) {
             snprintf(tmp, sizeof tmp, "<c%d>", i);
             strcat(xml, tmp);
-- 
